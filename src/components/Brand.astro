---
const { compact = false } = Astro.props;
---
<span class:list={['brand-lockup', { compact }]}>
  <img src="/logo.webp" alt="RentEase 9ja" width="200" height="104" />
</span>

<style>
  .brand-lockup, .brand-lockup img { display: block; width: 200px; height: auto; flex: none; }
  .compact, .compact img { width: 175px; height: auto; }
  @media (max-width: 480px) {
    .brand-lockup, .brand-lockup img { width: 175px; height: auto; }
  }
</style>
