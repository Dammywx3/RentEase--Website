---
const { inverse = false, compact = false } = Astro.props;
---
<span class:list={['brand-lockup', { inverse, compact }]}>
  <span class="brand-mark" aria-hidden="true"><i class="fas fa-house"></i></span>
  <span class="brand-name">RentEase <strong>9ja</strong></span>
</span>

<style>
  .brand-lockup { display: inline-flex; align-items: center; gap: 10px; color: var(--text); }
  .brand-mark { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 6px; background: var(--brand-blue); color: #fff; font-size: 1rem; }
  .brand-name { font-size: 1.12rem; font-weight: 750; line-height: 1; white-space: nowrap; }
  .brand-name strong { color: var(--brand-green-dark); font-weight: 750; }
  .inverse { color: #fff; }
  .inverse .brand-mark { background: #fff; color: var(--brand-blue); }
  .inverse .brand-name strong { color: #8FE3B9; }
  .compact .brand-mark { width: 34px; height: 34px; }
  .compact .brand-name { font-size: 1rem; }
</style>
