---
const { inverse = false, compact = false } = Astro.props;
const logoSrc = inverse ? '/brand-logo-light-v2.png' : '/brand-logo-v2.png';
---
<span class:list={['brand-lockup', { compact }]}>
  <img src={logoSrc} alt="RentEase 9ja" width="200" height="40" />
</span>

<style>
  .brand-lockup, .brand-lockup img { display: block; width: 200px; height: 40px; flex: none; }
  .compact, .compact img { width: 175px; height: 35px; }
  @media (max-width: 480px) {
    .brand-lockup, .brand-lockup img { width: 175px; height: 35px; }
  }
</style>
