---
const { image, price, title, location, kind = 'rent', verified = true, meta = [] } = Astro.props;
const kindLabel = kind === 'rent' ? 'For Rent' : kind === 'land' ? 'For Sale' : 'For Sale';
---
<a class="listing card" href="/waitlist">
  <div class="media">
    <img src={image} alt={title} width="800" height="600" loading="lazy" decoding="async" />
    {verified && <span class="tag verified"><i class="fas fa-circle-check"></i> Verified</span>}
    <span class:list={['tag', 'kind', kind]}>{kindLabel}</span>
  </div>
  <div class="body">
    <p class="price">{price}</p>
    <p class="title">{title}</p>
    <p class="loc"><i class="fas fa-location-dot"></i> {location}</p>
    {meta.length > 0 && (
      <ul class="meta">
        {meta.map((m) => (<li><i class={`fas ${m.icon}`}></i> {m.label}</li>))}
      </ul>
    )}
  </div>
</a>

<style>
  .listing { overflow: hidden; display: block; }
  .media { position: relative; aspect-ratio: 4 / 3; background: var(--mist); }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .tag {
    position: absolute; font-size: .72rem; font-weight: 700; color: #fff;
    padding: 6px 11px; border-radius: var(--r-sm); display: inline-flex; align-items: center; gap: 5px;
  }
  .verified { top: 12px; left: 12px; background: var(--brand-gradient); box-shadow: 0 4px 10px rgba(30,78,140,.3); }
  .kind { bottom: 12px; left: 12px; }
  .kind.rent { background: var(--brand-green); }
  .kind.buy, .kind.land { background: var(--brand-blue); }
  .body { padding: 18px 20px 22px; }
  .price { font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; color: var(--text); letter-spacing: -.02em; }
  .title { color: var(--text-2); font-weight: 600; margin-top: 4px; }
  .loc { color: var(--text-muted); font-size: .9rem; margin-top: 6px; }
  .meta { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); font-size: .85rem; color: var(--text-2); }
  .meta i { color: var(--brand-blue); }
</style>
