---
// MacBook Pro (2022) device frame wrapping the agent web dashboard.
// The whole laptop is built at a fixed design width and scaled-to-fit, so the
// full desktop layout stays intact and just shrinks on mobile (no reflow,
// no horizontal scroll).
import AgentDesktop from './AgentDesktop.astro';
---
<div class="lap-fit">
  <div class="lap">
    <div class="lap-screen">
      <div class="lap-cam"></div>
      <div class="lap-disp">
        <AgentDesktop />
      </div>
    </div>
    <div class="lap-base">
      <div class="lap-notch"></div>
    </div>
  </div>
</div>

<style>
  /* design width of the laptop incl. screen border; the script scales it to fit */
  /* align-items:flex-start is required — with the default `stretch`, setting the
     wrapper height (below) would stretch/collapse the laptop and break the fit math */
  .lap-fit { width: 100%; display: flex; justify-content: center; align-items: flex-start; overflow: hidden; }
  .lap { width: 1180px; flex: none; transform-origin: top center; }

  /* lid / screen */
  .lap-screen {
    position: relative; background: #0b0d12; border-radius: 22px 22px 10px 10px;
    padding: 30px 14px 14px; box-shadow: 0 2px 0 #2a2e36 inset, 0 0 0 2px #1c1f26;
  }
  .lap-cam { position: absolute; top: 13px; left: 50%; transform: translateX(-50%); width: 7px; height: 7px; border-radius: 50%; background: #2b2f38; box-shadow: 0 0 0 2px #14171d; }
  .lap-disp { border-radius: 4px; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.4); }

  /* base / hinge deck */
  .lap-base {
    position: relative; height: 16px; width: 112%; margin-left: -6%;
    background: linear-gradient(#c7ccd6, #aab0bd 55%, #8b91a0);
    border-radius: 0 0 12px 12px;
    box-shadow: 0 14px 26px -10px rgba(15,23,42,.45);
  }
  .lap-base::before { /* thin lip highlight */
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: rgba(255,255,255,.5);
  }
  .lap-notch { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 130px; height: 8px; background: #9aa1af; border-radius: 0 0 9px 9px; }

  @media (prefers-reduced-motion: no-preference) { .lap { transition: transform .25s ease; } }
</style>

<script>
  // @ts-nocheck
  (function () {
    var DESIGN = 1180; // must match .lap width
    function fit() {
      document.querySelectorAll('.lap-fit').forEach(function (wrap) {
        var lap = wrap.querySelector('.lap');
        if (!lap) return;
        var avail = wrap.clientWidth;
        if (!avail) return;
        var scale = Math.min(1, avail / DESIGN);
        lap.style.transform = 'scale(' + scale + ')';
        // offsetHeight is the untransformed layout height; reserve the scaled height
        wrap.style.height = (lap.offsetHeight * scale) + 'px';
      });
    }
    function setup() {
      fit();
      requestAnimationFrame(fit);
      [150, 500, 1200].forEach(function (t) { setTimeout(fit, t); });
      window.addEventListener('load', fit);
      window.addEventListener('resize', fit, { passive: true });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
      if (window.ResizeObserver) {
        // refit when the dashboard's own height settles (icon font, etc.)
        document.querySelectorAll('.lap-fit .lap').forEach(function (lap) {
          new ResizeObserver(fit).observe(lap);
        });
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup);
    else setup();
  })();
</script>
