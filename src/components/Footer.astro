---
const year = 2026;
const socials = [
  { href: 'https://x.com/rentease9ja', label: 'X (Twitter)', icon: 'fa-x-twitter' },
  { href: 'https://www.instagram.com/rentease9ja', label: 'Instagram', icon: 'fa-instagram' },
  { href: 'https://www.tiktok.com/@rentease_9ja', label: 'TikTok', icon: 'fa-tiktok' },
];
const cols = [
  { title: 'Company', links: [
    { href: '/aboutus', label: 'About us' },
    { href: '/team', label: 'Meet the team' },
    { href: '/for-developers', label: 'For developers' },
    { href: '/download', label: 'Desktop app' },
    { href: '/investors', label: 'Investors' },
    { href: '/waitlist', label: 'Join waitlist' },
  ]},
  { title: 'Explore', links: [
    { href: '/rent', label: 'Rent a home' },
    { href: '/buy', label: 'Buy property' },
    { href: '/land', label: 'Buy land' },
    { href: '/how-it-works', label: 'How it works' },
  ]},
  { title: 'Legal', links: [
    { href: '/privacy', label: 'Privacy policy' },
    { href: '/terms', label: 'Terms of service' },
  ]},
];
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/logo.webp" alt="RentEase 9ja" width="160" height="45" class="footer-logo" />
      <p class="motto">Building the future of renting in Nigeria.</p>
      <p>Nigeria's first end-to-end digital property platform. Verified listings, real agents, secure payments.</p>
      <div class="socials">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
            <i class={`fab ${s.icon}`}></i>
          </a>
        ))}
      </div>
      <div class="store-badges">
        <a href="/waitlist" aria-label="Download on the App Store"><img src="https://upload.wikimedia.org/wikipedia/commons/3/3c/Download_on_the_App_Store_Badge.svg" alt="App Store" height="40" loading="lazy" /></a>
        <a href="/waitlist" aria-label="Get it on Google Play"><img src="https://upload.wikimedia.org/wikipedia/commons/7/78/Google_Play_Store_badge_EN.svg" alt="Google Play" height="40" loading="lazy" /></a>
      </div>
    </div>

    {cols.map((c) => (
      <nav class="footer-col" aria-label={c.title}>
        <h4>{c.title}</h4>
        <ul>
          {c.links.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} RentEase 9ja. All rights reserved.</p>
    <p class="made">Built in Nigeria 🇳🇬</p>
  </div>
</footer>

<style>
  .site-footer { background: radial-gradient(120% 120% at 10% 0%, var(--navy-800), var(--navy-900)); color: var(--on-dark-2); padding-top: clamp(56px, 7vw, 88px); }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: clamp(28px, 4vw, 56px); padding-bottom: 48px; }
  .footer-logo { height: 48px; width: auto; margin-bottom: 20px; background: #fff; padding: 10px 16px; border-radius: 14px; box-shadow: 0 8px 20px rgba(0,0,0,.18); }
  .footer-brand .motto { font-family: var(--font-display); font-weight: 700; font-size: 1.08rem; color: #fff; max-width: 340px; margin-bottom: 10px; }
  .footer-brand p { font-size: .95rem; max-width: 360px; line-height: 1.7; }
  .socials { display: flex; gap: 12px; margin: 22px 0; }
  .socials a {
    width: 42px; height: 42px; border-radius: 50%;
    display: grid; place-items: center; font-size: 1.1rem; color: #fff;
    background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12);
    transition: var(--transition);
  }
  .socials a:hover { background: var(--brand-green); border-color: var(--brand-green); transform: translateY(-3px); }
  .store-badges { display: flex; gap: 12px; flex-wrap: wrap; }
  .footer-col h4 { color: #fff; font-family: var(--font-body); font-weight: 700; font-size: .82rem; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 18px; }
  .footer-col li { margin-bottom: 11px; }
  .footer-col a { font-size: .95rem; transition: var(--transition); }
  .footer-col a:hover { color: #fff; }
  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;
    border-top: 1px solid var(--navy-border); padding-block: 26px; font-size: .85rem;
  }
  @media (max-width: 920px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; } }
  /* Mobile: brand full-width on top, then the 3 link groups side by side as columns */
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: repeat(3, 1fr); gap: 24px 14px; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-col h4 { font-size: .72rem; margin-bottom: 13px; }
    .footer-col a { font-size: .82rem; }
    .footer-col li { margin-bottom: 10px; }
    .footer-bottom { justify-content: center; text-align: center; }
  }
</style>
