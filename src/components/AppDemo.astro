---
// Hand-driven, scripted in-app walkthrough for the How it works page.
// A finger signs in, verifies, then walks the full TENANT journey, faithfully
// recreated from the real app screens: Login → Verify → Welcome → Explore →
// Property details → Apply → Tenancy → Invoice → Pay → Success → Refer & Earn.
const sb = `<div class="dstatus"><span class="dtime">9:41</span><span class="dstatus-r"><i class="fas fa-signal"></i><span class="d5g">5G</span><i class="fas fa-battery-full"></i></span></div>`;
const houseA = "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=520&q=70&auto=format&fit=crop";
const houseB = "https://images.unsplash.com/photo-1570129477492-45c003edd2be?w=320&q=70&auto=format&fit=crop";
const houseC = "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=320&q=70&auto=format&fit=crop";
---
<section class="section section--mist demo-sec">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">See it in action</span>
      <h2>A real walkthrough — the tenant journey</h2>
      <p>Watch a tenant sign in, find a verified home, apply securely, pay rent in-app, and earn referral rewards — recreated from the live app, screen for screen.</p>
    </div>

    <div class="demo-wrap reveal" data-delay="1">
      <div class="demo-phone">
        <div class="demo-notch"></div>
        <div class="demo-viewport" id="demo-viewport">
          <span class="demo-role" id="demo-role">Tenant</span>

          <!-- 1) LOGIN -->
          <div class="dscreen active" data-screen="login">
            <Fragment set:html={sb} />
            <div class="dlogin">
              <h4>Welcome back</h4>
              <p class="dmuted dctr">Sign in to access your dashboard</p>
              <label>Email Address</label>
              <div class="dinput" id="tap-email"><i class="fas fa-envelope"></i> <span class="dtype" id="val-email"></span><span class="dcaret">|</span></div>
              <label>Password</label>
              <div class="dinput"><i class="fas fa-lock"></i> <span class="dtype" id="val-pass"></span><i class="fas fa-eye-slash deye"></i></div>
              <div class="dcheck-row"><span class="dcheck"><i class="fas fa-check"></i> Remember me</span><span class="dlink">Forgot password?</span></div>
              <div class="dbtn-g" id="tap-signin">Sign In</div>
              <div class="ddivider"><span>OR</span></div>
              <div class="dbtn-out"><i class="fab fa-apple"></i> Continue with Apple</div>
              <p class="dmuted dctr dxs" style="margin-top:16px;">Don't have an account? <b class="dlink">Create account</b></p>
            </div>
          </div>

          <!-- 2) VERIFY CODE -->
          <div class="dscreen" data-screen="verify">
            <Fragment set:html={sb} />
            <div class="dlogin">
              <div class="dback"><i class="fas fa-arrow-left"></i></div>
              <h4 class="dvtitle">Verify code</h4>
              <p class="dmuted dctr">We sent a 6-digit code to<br/>adigun@example.com</p>
              <div class="dverify-ico sm"><i class="fas fa-envelope-circle-check"></i></div>
              <div class="dotp" id="tap-otp">
                <span class="dotp-box" id="otp1"></span><span class="dotp-box" id="otp2"></span><span class="dotp-box" id="otp3"></span>
                <span class="dotp-box" id="otp4"></span><span class="dotp-box" id="otp5"></span><span class="dotp-box" id="otp6"></span>
              </div>
              <div class="dbtn-g" id="tap-confirm">Confirm</div>
              <p class="dmuted dctr" style="margin-top:14px;color:var(--brand-green);font-weight:700;">Resend code</p>
            </div>
          </div>

          <!-- 3) WELCOME -->
          <div class="dscreen" data-screen="welcome">
            <Fragment set:html={sb} />
            <div class="dwelcome">
              <h3 class="dwelcome-h">Good evening, Adigun <span class="dwave">👋</span></h3>
              <p class="dmuted dctr">You're logged in as a Tenant.</p>
              <div class="dwel-card">
                <span class="dpill grey">TENANT</span>
                <div class="dtitle big dctr">Ready to start?</div>
                <div class="dwel-ill"><i class="fas fa-house-chimney-window"></i></div>
                <div class="dbtn-g" id="tap-explore">Explore</div>
                <div class="dwel-switch">Switch account type</div>
                <div class="dmuted dxs dctr" style="margin-top:6px;">Last login: Today 17:38</div>
              </div>
            </div>
          </div>

          <!-- 4) EXPLORE -->
          <div class="dscreen" data-screen="explore">
            <Fragment set:html={sb} />
            <div class="dpad">
              <div class="dhead-row"><div class="davatar sm ph"><i class="don"></i></div><div class="dctr-h"><div class="dh">Explore</div><div class="dmuted dxs">Find your perfect place</div></div><div class="dhicons"><i class="fas fa-magnifying-glass"></i><i class="fas fa-bell"></i></div></div>
              <div class="dchips ic"><span class="dchip blk"><i class="fas fa-house"></i> Rent</span><span class="dchip"><i class="fas fa-bag-shopping"></i> Buy</span><span class="dchip"><i class="fas fa-tree"></i> Land</span><span class="dchip"><i class="fas fa-shield-halved"></i> Verified</span></div>
              <div class="dfeat" id="tap-feat" style={`background-image:linear-gradient(to top,rgba(8,15,30,.85),rgba(8,15,30,.1) 60%),url('${houseA}')`}>
                <span class="dfeat-badge">NEW</span><span class="dheart"><i class="fas fa-heart"></i></span>
                <div class="dfeat-ov"><div class="dfeat-t">Modern 3-Bed Flat</div><div class="dfeat-loc"><i class="fas fa-location-dot"></i> Lekki Phase 1, Lagos</div><div class="dfeat-price">₦2.5M<span>/yr</span></div><div class="dfeat-specs"><span>3 bd</span><span>2 ba</span></div></div>
                <div class="ddots"><i class="on"></i><i></i><i></i></div>
              </div>
              <div class="dsubh-row"><div class="dsubh"><i class="fas fa-fire dgold"></i> Trending This Week</div><span class="dseeall">See all ›</span></div>
              <div class="dtrend">
                <div class="dtc" style={`background-image:linear-gradient(to top,rgba(8,15,30,.8),rgba(8,15,30,.1)),url('${houseB}')`}><span class="dtc-tag">TRENDING</span><div class="dtc-b"><div class="dfeat-price sm">₦7.5M<span>/yr</span></div><div class="dtc-t">4-Bed Duplex</div><span class="dtc-unit">1 unit available</span></div></div>
                <div class="dtc" style={`background-image:linear-gradient(to top,rgba(8,15,30,.8),rgba(8,15,30,.1)),url('${houseC}')`}><span class="dtc-tag">TRENDING</span><div class="dtc-b"><div class="dfeat-price sm">₦1.2M<span>/yr</span></div><div class="dtc-t">2-Bed Flat</div><span class="dtc-unit">1 unit available</span></div></div>
              </div>
            </div>
            <nav class="dnav"><span class="dnv on"><i class="fas fa-compass"></i>Explore</span><span class="dnv"><i class="fas fa-heart"></i>Saved</span><span class="dnv"><i class="fas fa-comment"></i>Messages</span><span class="dnv"><i class="fas fa-wallet"></i>Wallet</span><span class="dnv"><i class="fas fa-table-cells-large"></i>More</span></nav>
          </div>

          <!-- 5) PROPERTY DETAILS -->
          <div class="dscreen" data-screen="details">
            <div class="ddet-img" style={`background-image:linear-gradient(to bottom,rgba(8,15,30,.35),rgba(8,15,30,.05)),url('${houseA}')`}>
              <div class="ddet-top"><span class="dcirc"><i class="fas fa-arrow-left"></i></span><div class="ddet-top-r"><span class="dcirc"><i class="fas fa-arrow-up-from-bracket"></i></span><span class="dcirc"><i class="fas fa-heart"></i></span></div></div>
              <span class="ddet-count">1 / 6</span>
            </div>
            <div class="dpad det">
              <div class="ddet-badges"><span class="dpill green">AVAILABLE</span><span class="dmuted dxs">Listed 2 days ago</span></div>
              <div class="dprice big">₦2.5M<span>/yr</span></div>
              <div class="dtitle big">Modern 3-Bed Flat</div>
              <div class="dloc"><i class="fas fa-location-dot"></i> Lekki Phase 1, Lagos</div>
              <div class="dspecs">
                <div class="dspec"><i class="fas fa-bed"></i><b>3</b><span>Beds</span></div>
                <div class="dspec"><i class="fas fa-bath"></i><b>2</b><span>Baths</span></div>
                <div class="dspec"><i class="fas fa-ruler-combined"></i><b>120</b><span>sqm</span></div>
                <div class="dspec"><i class="fas fa-shield-halved"></i><b class="green">✓</b><span>Verified</span></div>
              </div>
              <div class="ddet-actions"><span class="dcirc lg"><i class="fas fa-comment"></i></span><div class="dbtn-g" id="tap-apply2">Schedule Viewing</div><div class="dbtn-out narrow" id="tap-apply">Apply</div></div>
            </div>
          </div>

          <!-- 6) INITIATE APPLICATION -->
          <div class="dscreen" data-screen="apply">
            <Fragment set:html={sb} />
            <div class="dpad">
              <div class="dh dh-top dctr">Initiate Application</div>
              <div class="dmuted dxs dctr">Step 1 of 5</div>
              <div class="dsteps"><span class="on"></span><span></span><span></span><span></span><span></span></div>
              <div class="dapply-card" style={`background-image:linear-gradient(90deg,rgba(8,15,30,.55),rgba(8,15,30,.15)),url('${houseA}')`}>
                <span class="dpill green sm">AVAILABLE</span>
                <div class="dapply-t">Modern 3-Bed Flat</div>
                <div class="dapply-p">₦2,500,000 / year</div>
              </div>
              <div class="dsubh dxs spaced">APPLICATION REQUIREMENTS</div>
              <div class="dreq"><i class="fas fa-circle-check"></i> Valid Government Issued ID</div>
              <div class="dreq"><i class="fas fa-circle-check"></i> Live Selfie Verification</div>
              <div class="dreq"><i class="fas fa-circle-check"></i> Verified Guarantor Details <span class="dreq-req">(Required)</span></div>
              <div class="dbtn-g" id="tap-begin">Begin Secure Application <i class="fas fa-arrow-right"></i></div>
              <div class="dbtn-out">Schedule Viewing Instead</div>
            </div>
          </div>

          <!-- 7) MY TENANCY -->
          <div class="dscreen" data-screen="tenancy">
            <div class="dten-img" style={`background-image:linear-gradient(to bottom,rgba(8,15,30,.2),rgba(8,15,30,.7)),url('${houseA}')`}>
              <div class="ddet-top"><span class="dcirc"><i class="fas fa-arrow-left"></i></span></div>
              <div class="dten-name">Modern 3-Bed Flat</div>
            </div>
            <div class="dpad det">
              <div class="dsubh">Overview</div>
              <div class="dover"><div class="davatar sm">O</div><div class="drow-b"><div class="dmuted dxs">Landlord / Manager</div><div class="dtitle">Mr. Okoro</div></div><span class="dcirc sm blue"><i class="fas fa-comment"></i></span></div>
              <div class="dsubh">Rent &amp; Payments</div>
              <div class="dpay-box">
                <div class="dpay-row"><span>Monthly rent</span><b>₦250,000</b></div>
                <div class="dpay-row"><span>Next due date</span><b>Apr 2, 2026</b></div>
                <div class="dpay-row"><span>Status</span><b class="dpill green xs">ACTIVE</b></div>
              </div>
              <div class="dbtn-g" id="tap-payrent">Pay rent</div>
              <div class="dten-links"><span><i class="fas fa-file-lines"></i> Lease docs</span><span><i class="fas fa-screwdriver-wrench"></i> Maintenance</span></div>
            </div>
          </div>

          <!-- 8) INVOICE DETAILS -->
          <div class="dscreen" data-screen="invoice">
            <Fragment set:html={sb} />
            <div class="dpad">
              <div class="dh dh-top dctr">Invoice Details</div>
              <div class="dmuted dxs dctr">Total Amount</div>
              <div class="dinv-total">₦250,000</div>
              <div class="dctr"><span class="dpill blue-soft">Issued · Due 2/3/2026</span></div>
              <div class="dsubh" style="margin-top:14px;">Breakdown</div>
              <div class="dbreak">
                <div class="dbk-row"><span>Invoice</span><b>#100128</b></div>
                <div class="dbk-row"><span>Status</span><b>Issued</b></div>
                <div class="dbk-row"><span>Due Date</span><b>2/3/2026</b></div>
                <div class="dbk-sep"></div>
                <div class="dbk-row"><span>Subtotal</span><b>₦250,000</b></div>
                <div class="dbk-row"><span>Late Fee</span><b>₦0</b></div>
                <div class="dbk-row"><span>Total</span><b class="green">₦250,000</b></div>
              </div>
              <div class="dbtn-g" id="tap-pay">Pay ₦250,000</div>
            </div>
          </div>

          <!-- 9) SELECT PAYMENT -->
          <div class="dscreen" data-screen="payment">
            <Fragment set:html={sb} />
            <div class="dpad">
              <div class="dh dh-top dctr">Select Payment</div>
              <div class="dmuted dxs dctr spaced">PAYING FOR</div>
              <div class="dtitle dctr">Invoice Payment</div>
              <div class="dinv-total sm">₦250,000</div>
              <div class="dsubh dxs spaced">INSTANT METHODS</div>
              <div class="dpm"><span class="dpm-ic blue"><i class="fas fa-credit-card"></i></span><div class="drow-b"><div class="dtitle">Pay with Paystack</div><div class="dmuted dxs">Card, USSD, Transfer</div></div><i class="fas fa-chevron-right dmuted"></i></div>
              <div class="dpm" id="tap-wallet"><span class="dpm-ic green"><i class="fas fa-wallet"></i></span><div class="drow-b"><div class="dtitle">Pay via Wallet</div><div class="dmuted dxs">Available: ₦980,250.00</div></div><i class="fas fa-chevron-right dmuted"></i></div>
              <div class="dsubh dxs spaced">MANUAL METHODS</div>
              <div class="dpm"><span class="dpm-ic grey"><i class="fas fa-building-columns"></i></span><div class="drow-b"><div class="dtitle">Direct Bank Transfer</div><div class="dmuted dxs">Get account details & narration</div></div><i class="fas fa-chevron-right dmuted"></i></div>
            </div>
          </div>

          <!-- 10) PAYMENT SUCCESS -->
          <div class="dscreen" data-screen="success">
            <Fragment set:html={sb} />
            <div class="dsucc">
              <div class="dsucc-ck"><i class="fas fa-check"></i></div>
              <h4>Payment Successful</h4>
              <p class="dmuted dctr">You paid ₦250,000 to<br/>RentEase 9ja Homes &amp; Property Ltd</p>
              <div class="dsucc-sec"><i class="fas fa-lock"></i> Secured by Paystack</div>
            </div>
          </div>

          <!-- 11) REFER & EARN -->
          <div class="dscreen" data-screen="referral">
            <Fragment set:html={sb} />
            <div class="dpad">
              <div class="dh dh-top dctr">Refer &amp; Earn</div>
              <div class="dmuted dxs dctr">Invite friends, earn rewards</div>
              <div class="dref-card">
                <div class="dref-h"><i class="fas fa-gift"></i> Invite &amp; Get ₦2,000</div>
                <div class="dref-sub">You get ₦2,000. They get ₦1,000 off.</div>
                <div class="dref-code"><span>DAMMY</span><i class="fas fa-share-nodes"></i></div>
              </div>
              <div class="dstat-row">
                <div class="dstat"><div class="dstat-n">₦0</div><div class="dstat-l">Earned</div></div>
                <div class="dstat"><div class="dstat-n">3</div><div class="dstat-l">Pending</div></div>
                <div class="dstat"><div class="dstat-n">0</div><div class="dstat-l">Success</div></div>
              </div>
              <div class="dsubh">History</div>
              <div class="drow sm"><div class="dinitial">F</div><div class="drow-b"><div class="dtitle">Funmi Adeyemi</div><div class="dmuted dxs">17/6/2026</div></div><span class="dpill amber xs">Pending</span></div>
              <div class="drow sm"><div class="dinitial">A</div><div class="drow-b"><div class="dtitle">Adigun Dami</div><div class="dmuted dxs">17/6/2026</div></div><span class="dpill amber xs">Pending</span></div>
            </div>
          </div>

          <!-- HAND CURSOR + tap ripple -->
          <i class="fas fa-hand-pointer demo-hand" id="demo-hand" aria-hidden="true"></i>
          <span class="demo-ripple" id="demo-ripple" aria-hidden="true"></span>
        </div>
      </div>

      <div class="demo-caption">
        <span class="eyebrow" id="demo-eyebrow">Secure sign-in</span>
        <p id="demo-cap">A hand walks through exactly what a tenant does in the app.</p>
        <button class="demo-replay" id="demo-replay"><i class="fas fa-rotate-right"></i> Replay</button>
      </div>
    </div>
  </div>
</section>

<style>
  .demo-wrap { display: flex; align-items: center; justify-content: center; gap: clamp(28px, 6vw, 80px); flex-wrap: wrap; }
  .demo-phone { position: relative; width: 300px; height: 610px; flex-shrink: 0; background: #0B1020; border-radius: 42px; padding: 12px; box-shadow: 0 40px 80px rgba(15,23,42,.28), inset 0 0 0 2px rgba(255,255,255,.06); }
  .demo-notch { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); width: 120px; height: 22px; background: #0B1020; border-radius: 0 0 16px 16px; z-index: 9; }
  .demo-viewport { position: relative; width: 100%; height: 100%; border-radius: 32px; overflow: hidden; background: var(--bg); }
  .demo-role { position: absolute; top: 10px; left: 14px; z-index: 8; background: var(--brand-gradient); color: #fff; font-size: 9px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; }

  .dscreen { position: absolute; inset: 0; display: flex; flex-direction: column; opacity: 0; transform: translateX(20px); transition: opacity .5s ease, transform .5s cubic-bezier(.2,.7,.2,1); pointer-events: none; background: var(--bg); }
  .dscreen.active { opacity: 1; transform: none; }

  .dstatus { display: flex; justify-content: space-between; align-items: center; padding: 9px 16px 4px; font-size: 11px; font-weight: 700; color: var(--text); }
  .dtime { background: #2BB673; color: #fff; padding: 2px 9px; border-radius: 999px; font-size: 10.5px; }
  .dstatus-r { display: flex; gap: 5px; align-items: center; font-size: 9px; } .d5g { font-size: 9px; font-weight: 800; }
  .dpad { flex: 1; padding: 14px 16px 0; overflow: hidden; } .dpad.det { padding-top: 12px; }

  .dmuted { color: var(--text-muted); } .dxs { font-size: 10.5px; } .dctr { text-align: center; } .dctr-h { text-align: center; flex: 1; }
  .dh { font-family: var(--font-display); font-weight: 800; font-size: 21px; color: var(--text); letter-spacing: -.02em; }
  .dh-top { margin: 2px 0 2px; }
  .dhead-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 12px; }
  .dhicons { display: flex; gap: 10px; font-size: 14px; color: var(--text-2); }
  .davatar { width: 36px; height: 36px; border-radius: 50%; background: var(--brand-gradient); color: #fff; font-weight: 800; display: grid; place-items: center; font-size: 14px; flex: none; }
  .davatar.sm { width: 30px; height: 30px; font-size: 12px; } .davatar.ph { background: linear-gradient(135deg,#94a3b8,#475569); position: relative; }
  .don { position: absolute; bottom: 0; right: 0; width: 8px; height: 8px; border-radius: 50%; background: #22C55E; border: 2px solid #fff; }

  .dchips { display: flex; gap: 7px; margin: 4px 0 12px; }
  .dchip { font-size: 11px; font-weight: 700; padding: 7px 13px; border-radius: 999px; background: var(--surface); border: 1px solid var(--border); color: var(--text-2); display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
  .dchips.ic .dchip i { color: var(--brand-green); font-size: 10px; }
  .dchip.blk { background: #0F172A; color: #fff; border-color: #0F172A; } .dchip.blk i { color: #5CE1A0; }

  .dsubh { font-weight: 800; font-size: 13px; color: var(--text); margin: 10px 0 9px; display: inline-flex; align-items: center; gap: 6px; }
  .dsubh.spaced { letter-spacing: .08em; color: var(--text-muted); font-size: 10px; }
  .dsubh-row { display: flex; justify-content: space-between; align-items: center; }
  .dseeall { font-size: 10.5px; font-weight: 700; color: var(--brand-green); }
  .dgold { color: #F59E0B; }

  /* featured / cards */
  .dfeat { position: relative; height: 170px; border-radius: 16px; overflow: hidden; background-size: cover; background-position: center; display: flex; align-items: flex-end; box-shadow: var(--shadow-card); }
  .dfeat-badge { position: absolute; top: 10px; left: 10px; background: var(--brand-blue); color: #fff; font-size: 9px; font-weight: 800; padding: 4px 9px; border-radius: 999px; letter-spacing: .04em; }
  .dheart { position: absolute; top: 9px; right: 9px; width: 26px; height: 26px; border-radius: 50%; background: rgba(0,0,0,.35); color: #ff5a7a; display: grid; place-items: center; font-size: 11px; }
  .dfeat-ov { padding: 14px; color: #fff; width: 100%; }
  .dfeat-t { font-family: var(--font-display); font-weight: 800; font-size: 18px; }
  .dfeat-loc { font-size: 11px; opacity: .92; margin: 3px 0 5px; }
  .dfeat-price { font-family: var(--font-display); font-weight: 800; font-size: 18px; color: #5CE1A0; } .dfeat-price span { font-size: 11px; color: #cbd5e1; font-weight: 600; }
  .dfeat-price.sm { font-size: 14px; } .dfeat-price.sm span { font-size: 9px; }
  .dfeat-specs { display: flex; gap: 6px; margin-top: 7px; }
  .dfeat-specs span { background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.28); border-radius: 6px; padding: 3px 9px; font-size: 9.5px; font-weight: 600; }
  .ddots { position: absolute; bottom: 9px; right: 12px; display: flex; gap: 4px; }
  .ddots i { width: 5px; height: 5px; border-radius: 999px; background: rgba(255,255,255,.5); } .ddots i.on { width: 13px; background: #2BB673; }

  .dtrend { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; margin-top: 10px; }
  .dtc { position: relative; height: 116px; border-radius: 13px; overflow: hidden; background-size: cover; background-position: center; display: flex; align-items: flex-end; }
  .dtc-tag { position: absolute; top: 7px; left: 7px; background: #F2742B; color: #fff; font-size: 7.5px; font-weight: 800; padding: 3px 7px; border-radius: 999px; }
  .dtc-b { padding: 9px; color: #fff; } .dtc-t { font-size: 11px; font-weight: 700; }
  .dtc-unit { display: inline-block; margin-top: 4px; background: rgba(43,182,115,.85); color: #fff; font-size: 7.5px; font-weight: 700; padding: 2px 6px; border-radius: 5px; }

  /* property details */
  .ddet-img { height: 232px; background-size: cover; background-position: center; position: relative; display: flex; flex-direction: column; justify-content: space-between; padding: 12px; }
  .ddet-top { display: flex; justify-content: space-between; align-items: flex-start; padding-top: 14px; }
