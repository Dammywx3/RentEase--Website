  .dpill.xs { font-size: 8px; padding: 3px 7px; }
  .dpill.green { background: rgba(43,182,115,.16); color: #1f8f5a; } .dpill.amber { background: rgba(245,158,11,.16); color: #b9770a; }
  .dpill.grey { background: #EEF0F4; color: #475569; } .dpill.blue-soft { background: rgba(30,78,140,.1); color: var(--brand-blue); }
  .dpill.sm { font-size: 8px; }

  .dnav { display: flex; justify-content: space-around; align-items: center; padding: 8px 0 14px; border-top: 1px solid var(--border); background: var(--surface); }
  .dnv { display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 8.5px; font-weight: 600; color: var(--text-muted); } .dnv i { font-size: 15px; }
  .dnv.on { color: var(--brand-green); }

  /* login / verify */
  .dlogin { padding: 18px 22px 0; display: flex; flex-direction: column; }
  .dlogin h4 { font-family: var(--font-display); font-weight: 800; font-size: 22px; color: var(--text); text-align: center; margin-top: 10px; }
  .dlogin .dmuted { font-size: 11.5px; margin-bottom: 14px; }
  .dlogin label { font-size: 10.5px; font-weight: 700; color: var(--text-2); margin: 9px 0 5px; }
  .dinput { background: var(--surface-2); border: 1px solid var(--border); border-radius: 11px; padding: 11px 12px; font-size: 12px; color: var(--text-2); display: flex; gap: 8px; align-items: center; min-height: 42px; }
  .dinput i { color: var(--text-muted); } .deye { margin-left: auto; }
  .dtype { white-space: nowrap; } .dcaret { color: var(--brand-green); font-weight: 700; opacity: 0; }
  .dinput.typing .dcaret { opacity: 1; animation: blink 1s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .dcheck-row { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; font-size: 11px; }
  .dcheck { color: var(--text-2); font-weight: 600; } .dcheck i { color: #fff; background: var(--brand-green); border-radius: 4px; padding: 2px; font-size: 7px; margin-right: 5px; }
  .dlink { color: var(--brand-blue); font-weight: 700; }
  .dbtn-g { background: #2E8B57; color: #fff; text-align: center; font-weight: 700; font-size: 14px; padding: 13px; border-radius: 12px; margin-top: 16px; display: flex; gap: 8px; align-items: center; justify-content: center; }
  .ddivider { text-align: center; position: relative; margin: 14px 0; }
  .ddivider::before { content: ''; position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: var(--border); }
  .ddivider span { position: relative; background: var(--bg); padding: 0 10px; font-size: 10px; color: var(--text-muted); letter-spacing: .1em; }
  .dbtn-out { border: 1px solid var(--border); background: var(--surface); color: var(--text); text-align: center; font-weight: 700; font-size: 13px; padding: 12px; border-radius: 12px; display: flex; gap: 8px; align-items: center; justify-content: center; margin-top: 10px; }
  .dbtn-out .fa-apple { color: var(--text); }
  .dback { font-size: 16px; color: var(--text); } .dvtitle { margin-top: 2px; }
  .dverify-ico { width: 56px; height: 56px; border-radius: 50%; background: var(--brand-gradient-soft); color: var(--brand-blue); display: grid; place-items: center; font-size: 22px; margin: 8px auto 14px; }
  .dverify-ico.sm { width: 48px; height: 48px; font-size: 18px; margin: 16px auto 8px; }
  .dotp { display: flex; gap: 8px; justify-content: center; margin: 16px 0 4px; }
  .dotp-box { width: 36px; height: 46px; border-radius: 11px; border: 1.5px solid var(--border); background: var(--surface-2); display: grid; place-items: center; font-size: 20px; color: var(--text); }
  .dotp-box.filled { border-color: var(--brand-green); background: #fff; }

  /* welcome */
  .dwelcome { padding: 30px 22px 0; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .dwelcome-h { font-family: var(--font-display); font-weight: 800; font-size: 21px; color: var(--text); margin: 4px 0; } .dwave { display: inline-block; }
  .dwel-card { width: 100%; margin-top: 18px; background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 18px; box-shadow: var(--shadow-card); }
  .dwel-ill { height: 96px; border-radius: 12px; background: var(--brand-gradient-soft); display: grid; place-items: center; font-size: 40px; color: var(--brand-blue); margin: 12px 0 14px; }
  .dwel-switch { color: var(--brand-blue); font-weight: 700; font-size: 12px; margin-top: 12px; }

  /* hand + ripple */
  .demo-hand { position: absolute; left: 0; top: 0; z-index: 12; font-size: 30px; color: #0B1020; filter: drop-shadow(0 4px 6px rgba(0,0,0,.3)); transform: translate(140px, 360px) rotate(-12deg); transition: transform .65s cubic-bezier(.4,.1,.2,1); pointer-events: none; opacity: .92; }
  .demo-hand.tap { transform: translate(var(--hx), var(--hy)) rotate(-12deg) scale(.82); transition: transform .12s ease; }
  .demo-ripple { position: absolute; z-index: 11; width: 30px; height: 30px; border-radius: 50%; background: rgba(43,182,115,.35); transform: translate(-50%, -50%) scale(0); opacity: 0; pointer-events: none; }
  .demo-ripple.go { animation: ripple .5s ease-out; }
  @keyframes ripple { 0% { transform: translate(-50%,-50%) scale(0); opacity: .7; } 100% { transform: translate(-50%,-50%) scale(3.2); opacity: 0; } }

  /* caption */
  .demo-caption { max-width: 320px; }
  .demo-caption .eyebrow { display: inline-block; }
  .demo-caption p { font-size: 1.25rem; font-weight: 600; color: var(--text); line-height: 1.45; margin-top: 10px; min-height: 84px; transition: opacity .3s ease; }
  .demo-replay { margin-top: 6px; background: var(--surface); border: 1px solid var(--border); color: var(--brand-blue); font-weight: 700; font-size: .9rem; padding: 9px 18px; border-radius: var(--r-pill); cursor: pointer; display: inline-flex; gap: 8px; align-items: center; }
  .demo-replay:hover { background: var(--brand-gradient-soft); }
  @media (max-width: 760px) { .demo-caption { max-width: 320px; text-align: center; } }
  @media (prefers-reduced-motion: reduce) { .dscreen, .demo-hand { transition: none; } }
</style>

<script is:inline>
  (function () {
    const vp = document.getElementById('demo-viewport');
    if (!vp) return;
    const hand = document.getElementById('demo-hand');
    const ripple = document.getElementById('demo-ripple');
    const capEl = document.getElementById('demo-cap');
    const eyeEl = document.getElementById('demo-eyebrow');
    const screens = {};
    vp.querySelectorAll('[data-screen]').forEach((s) => (screens[s.dataset.screen] = s));
    let cancelled = true, running = false;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const wait = (ms) => new Promise((r) => setTimeout(r, ms));
    function showScreen(name) {
      Object.values(screens).forEach((s) => s.classList.remove('active'));
      screens[name].classList.add('active');
    }
    function setCap(eye, text) { eyeEl.textContent = eye; capEl.style.opacity = 0; setTimeout(() => { capEl.textContent = text; capEl.style.opacity = 1; }, 200); }

    function handTo(sel) {
      const el = document.querySelector(sel);
      if (!el) return;
      const er = el.getBoundingClientRect(), vr = vp.getBoundingClientRect();
      const x = er.left - vr.left + er.width / 2 - 4;
      const y = er.top - vr.top + er.height / 2 + 2;
      hand.style.setProperty('--hx', x + 'px');
      hand.style.setProperty('--hy', y + 'px');
      hand.style.transform = `translate(${x}px, ${y}px) rotate(-12deg)`;
    }
    async function tap(sel) {
      handTo(sel); await wait(reduce ? 0 : 680);
      const el = document.querySelector(sel);
      if (el) {
        const er = el.getBoundingClientRect(), vr = vp.getBoundingClientRect();
        ripple.style.left = er.left - vr.left + er.width / 2 + 'px';
        ripple.style.top = er.top - vr.top + er.height / 2 + 'px';
        ripple.classList.remove('go'); void ripple.offsetWidth; ripple.classList.add('go');
      }
      hand.classList.add('tap'); await wait(150); hand.classList.remove('tap');
    }
    async function type(sel, text, opts) {
      handTo(sel); await wait(reduce ? 0 : 600);
      const el = document.querySelector(sel);
      if (!el) return;
      if (opts && opts.otp) {
        const boxes = ['#otp1', '#otp2', '#otp3', '#otp4', '#otp5', '#otp6'];
        for (let i = 0; i < boxes.length; i++) { const b = document.querySelector(boxes[i]); b.textContent = '●'; b.classList.add('filled'); await wait(reduce ? 0 : 180); }
        return;
      }
      const field = el.classList.contains('dinput') ? el : el.closest('.dinput');
      if (field) field.classList.add('typing');
      el.textContent = '';
      for (let i = 0; i < text.length; i++) { if (cancelled) return; el.textContent += text[i]; await wait(reduce ? 0 : 50); }
      if (field) setTimeout(() => field.classList.remove('typing'), 600);
    }

    const script = [
      { do: () => { showScreen('login'); setCap('Secure sign-in', 'A tenant signs in to one secure account.'); } },
      { fn: () => type('#val-email', 'adigun@example.com') },
      { fn: () => type('#val-pass', '••••••••') },
      { fn: () => tap('#tap-signin'), after: () => { showScreen('verify'); setCap('Verify it’s you', 'A one-time code keeps every account safe.'); }, gap: 500 },
      { fn: () => type('#tap-otp', '124863', { otp: true }) },
      { fn: () => tap('#tap-confirm'), after: () => { showScreen('welcome'); setCap('Welcome 👋', 'Good evening, Adigun — straight to your dashboard.'); }, gap: 1500 },
      { fn: () => tap('#tap-explore'), after: () => { showScreen('explore'); setCap('Explore', 'Browse verified homes — filter by rent, buy or land.'); }, gap: 1900 },
      { fn: () => tap('#tap-feat'), after: () => { showScreen('details'); setCap('Property details', 'Full photos, specs and a verified badge on every listing.'); }, gap: 1900 },
      { fn: () => tap('#tap-apply'), after: () => { showScreen('apply'); setCap('Apply securely', 'KYC, live selfie and guarantor checks — fraud-proof.'); }, gap: 2000 },
      { fn: () => tap('#tap-begin'), after: () => { showScreen('tenancy'); setCap('Your tenancy', 'Once approved, track rent, status and your landlord.'); }, gap: 2000 },
      { fn: () => tap('#tap-payrent'), after: () => { showScreen('invoice'); setCap('Rent invoice', 'Clear breakdown — no hidden fees.'); }, gap: 1700 },
      { fn: () => tap('#tap-pay'), after: () => { showScreen('payment'); setCap('Pay your way', 'Paystack, wallet or bank transfer.'); }, gap: 1700 },
      { fn: () => tap('#tap-wallet'), after: () => { showScreen('success'); setCap('Paid securely', 'Rent paid via secure wallet — instantly.'); }, gap: 1900 },
      { do: () => { showScreen('referral'); setCap('Refer & earn', 'Invite friends and earn ₦2,000 per referral.'); }, gap: 2200 },
    ];

    function resetTransients() {
      document.getElementById('val-email').textContent = '';
      document.getElementById('val-pass').textContent = '';
      ['#otp1', '#otp2', '#otp3', '#otp4', '#otp5', '#otp6'].forEach((s) => { const b = document.querySelector(s); b.textContent = ''; b.classList.remove('filled'); });
    }

    async function loop() {
      running = true;
      while (!cancelled) {
        for (const step of script) {
          if (cancelled) break;
          if (step.before) step.before();
          if (step.do) step.do();
          if (step.fn) await step.fn();
          if (cancelled) break;
          if (step.after) step.after();
          await wait(reduce ? 700 : (step.gap || 700));
        }
        resetTransients();
      }
      running = false;
    }

    function start() { if (running) return; cancelled = false; loop(); }
    async function restart() {
      cancelled = true;
      let guard = 0;
      while (running && guard++ < 80) await wait(80);
      resetTransients();
      showScreen('login');
      start();
    }

    document.getElementById('demo-replay').addEventListener('click', restart);

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) start(); }), { threshold: 0.25 });
      io.observe(vp);
    }
    setTimeout(start, 2500);
  })();
</script>
