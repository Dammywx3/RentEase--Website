---
const {type = '', category = '', limit = 12, compact = false} = Astro.props;
---
<public-listings data-type={type} data-category={category} data-limit={limit} data-compact={String(compact)}>
  {!compact && <label class="sort">Sort listings <select aria-label="Sort listings"><option value="newest">Newest first</option><option value="price_asc">Price: low to high</option><option value="price_desc">Price: high to low</option></select></label>}
  <p class="feed-status" role="status" aria-live="polite">Loading available properties...</p>
  <div class="public-grid" aria-busy="true"></div>
  <div class="feed-actions"><button class="btn btn-ghost retry" hidden>Try again</button><button class="btn btn-ghost load-more" hidden>Load more</button></div>
  <noscript>Enable JavaScript to load current listings from RentEase.</noscript>
</public-listings>
<script>
  import {initializePublicListings} from '../scripts/public-listings';
  document.querySelectorAll<HTMLElement>('public-listings').forEach(initializePublicListings);
</script>
<style is:global>
  public-listings { display:block; }
  public-listings [hidden] { display:none !important; }
  .public-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; }
  .public-listing { display:block; overflow:hidden; border:1px solid var(--border); border-radius:8px; background:var(--surface); min-width:0; }
  .public-listing:focus-visible { outline:3px solid var(--brand-green); outline-offset:4px; }
  .public-listing .photo { aspect-ratio:4/3; background:var(--mist); display:flex; align-items:center; justify-content:center; color:var(--text-muted); overflow:hidden; }
  .public-listing img { width:100%; height:100%; object-fit:cover; }
  .public-listing .details { padding:18px; overflow-wrap:anywhere; }
  .public-listing h3 { font-size:1.1rem; margin:8px 0; }
  .public-listing .price { font-weight:700; font-size:1.2rem; color:var(--brand-green); }
  .public-listing .location,.public-listing .facts { color:var(--text-muted); font-size:.9rem; margin-top:8px; }
  .public-listing .type { font-size:.8rem; color:var(--text-muted); }
  .feed-status { margin:16px 0; color:var(--text-muted); }
  .feed-actions { display:flex; justify-content:center; gap:12px; margin-top:24px; }
  public-listings .sort { display:flex; align-items:center; justify-content:flex-end; gap:12px; flex-wrap:wrap; margin-bottom:24px; }
  public-listings select { min-height:44px; max-width:100%; border:1px solid var(--border); border-radius:8px; padding:8px 12px; background:var(--surface); color:var(--text); font:inherit; }
  @media(max-width:900px) { .public-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:560px) { .public-grid { grid-template-columns:minmax(0,1fr); } }
</style>
