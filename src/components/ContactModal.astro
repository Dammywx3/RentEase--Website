---
// Site-wide contact modal. Any link/button with [data-contact] or href="#contact"
// opens it and submits the message through the public contact API.
import { WHATSAPP_NUMBER } from '../config';
---
<div class="cm-overlay" id="contact-modal" role="dialog" aria-modal="true" aria-labelledby="cm-title" hidden>
  <div class="cm-card" role="document">
    <button class="cm-close" type="button" aria-label="Close" data-cm-close>&times;</button>

    <form class="cm-body" id="cm-body" novalidate>
      <span class="eyebrow">Contact us</span>
      <h2 id="cm-title">Get in touch</h2>
      <p class="cm-sub">Tell us what you need and we'll get back to you. Sends to <strong>support@rentease9ja.com</strong>.</p>

      <div class="cm-error" id="cm-error" role="alert" aria-live="polite"></div>

      <div class="cm-row">
        <div class="cm-field">
          <label for="cm-name">Name</label>
          <input type="text" id="cm-name" placeholder="Your name" autocomplete="name" required />
        </div>
        <div class="cm-field">
          <label for="cm-email">Email</label>
          <input type="email" id="cm-email" placeholder="you@example.com" autocomplete="email" required />
        </div>
      </div>
      <div class="cm-field">
        <label for="cm-subject">Subject</label>
        <input type="text" id="cm-subject" placeholder="What is this about?" />
      </div>
      <div class="cm-field">
        <label for="cm-message">Message</label>
        <textarea id="cm-message" rows="4" placeholder="How can we help?" required></textarea>
      </div>

      <button class="btn btn-primary cm-send" type="submit" id="cm-send">Send message <i class="fas fa-paper-plane"></i></button>

      {WHATSAPP_NUMBER && (
        <>
          <div class="cm-or"><span>or</span></div>
          <a class="cm-whatsapp" href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer">
            <i class="fab fa-whatsapp"></i> Chat with us on WhatsApp
          </a>
        </>
      )}
    </form>

    <div class="cm-success" id="cm-success" role="status" aria-live="polite" tabindex="-1">
      <span class="cm-success-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.8 10A10 10 0 1 1 17 3.3"/><path d="m9 11 3 3L22 4"/></svg></span>
      <h3>Message sent!</h3>
      <p>Thanks for reaching out. We've received your message and will reply by email shortly.</p>
      <button class="btn btn-ghost" type="button" data-cm-close>Close</button>
    </div>
  </div>
</div>

<style>
  .cm-overlay { position: fixed; inset: 0; z-index: 2000; display: none; align-items: center; justify-content: center; padding: 20px; background: rgba(11,16,32,.55); backdrop-filter: blur(4px); }
  .cm-overlay.open { display: flex; }
  .cm-card { position: relative; width: 100%; max-width: 480px; background: var(--surface); border-radius: var(--r-xl); padding: clamp(26px, 4vw, 40px); box-shadow: 0 30px 70px rgba(0,0,0,.35); max-height: 92vh; overflow-y: auto; animation: cmIn .25s cubic-bezier(.2,.7,.2,1); }
  @keyframes cmIn { from { opacity: 0; transform: translateY(16px) scale(.98); } to { opacity: 1; transform: none; } }
  .cm-close { position: absolute; top: 10px; right: 10px; width: 44px; height: 44px; background: none; border: none; font-size: 1.8rem; line-height: 1; color: var(--text-muted); cursor: pointer; }
  .cm-close:hover { color: var(--text); }
  .cm-body h2, .cm-success h3 { margin: 10px 0 6px; }
  .cm-sub { color: var(--text-muted); font-size: .95rem; margin-bottom: 18px; }
  .cm-row { display: flex; gap: 14px; }
  .cm-row .cm-field { flex: 1; }
  .cm-field { margin-bottom: 14px; text-align: left; }
  .cm-field label { display: block; font-size: .82rem; font-weight: 600; color: var(--text-2); margin-bottom: 6px; }
  .cm-field input, .cm-field textarea { width: 100%; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--r-md); font: inherit; font-size: .95rem; background: var(--surface-2); color: var(--text); outline: none; transition: var(--transition); resize: vertical; }
  .cm-field input:focus, .cm-field textarea:focus { border-color: var(--brand-blue); background: #fff; box-shadow: 0 0 0 4px rgba(30,78,140,.12); }
  .cm-field input.err, .cm-field textarea.err { border-color: var(--danger); background: #FEF2F2; }
  .cm-send { width: 100%; margin-top: 6px; justify-content: center; }
  .cm-or { display: flex; align-items: center; gap: 12px; margin: 14px 0; color: var(--text-muted); font-size: .82rem; }
  .cm-or::before, .cm-or::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  .cm-whatsapp { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 13px; border-radius: var(--r-md); font-weight: 700; color: #fff; background: #25D366; transition: var(--transition); }
  .cm-whatsapp:hover { background: #1EBE5A; transform: translateY(-1px); }
  .cm-whatsapp i { font-size: 1.15rem; }
  .cm-error { display: none; background: #FEF2F2; border-left: 4px solid var(--danger); color: #B91C1C; font-size: .88rem; padding: 10px 14px; border-radius: var(--r-sm); margin-bottom: 14px; }
  .cm-error.show { display: block; }
  .cm-success { display: none; text-align: center; padding: 6px 0; }
  .cm-success.show { display: block; }
  .cm-success-ico { display: inline-flex; color: var(--brand-green); }
  .cm-success-ico svg { width: 48px; height: 48px; }
  .cm-success p { color: var(--text-muted); margin: 8px 0 20px; }
  .cm-success a { color: var(--brand-blue); font-weight: 600; }
  @media (max-width: 460px) { .cm-row { flex-direction: column; gap: 0; } }
</style>

<script>
  // @ts-nocheck
  import { API_BASE } from '../config';

  (function () {
    const SUPPORT = 'support@rentease9ja.com';
    const overlay = document.getElementById('contact-modal');
    if (!overlay) return;
    const body = document.getElementById('cm-body');
    const success = document.getElementById('cm-success');
    const errorBox = document.getElementById('cm-error');
    const form = document.getElementById('cm-body');
    const $ = (id) => document.getElementById(id);
    let lastFocused = null;

    function open(prefillSubject) {
      lastFocused = document.activeElement;
      body.style.display = ''; success.classList.remove('show'); errorBox.classList.remove('show');
      if (prefillSubject && !$('cm-subject').value) $('cm-subject').value = prefillSubject;
      overlay.hidden = false; requestAnimationFrame(() => overlay.classList.add('open'));
      document.body.style.overflow = 'hidden';
      setTimeout(() => $('cm-name').focus(), 60);
    }
    function close() {
      overlay.classList.remove('open');
      document.body.style.overflow = '';
      setTimeout(() => { overlay.hidden = true; }, 200);
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    }

    function showErr(msg, field) {
      errorBox.textContent = msg; errorBox.classList.add('show');
      ['cm-name','cm-email','cm-subject','cm-message'].forEach((id) => $(id).classList.remove('err'));
      if (field) { $(field).classList.add('err'); $(field).focus(); }
    }

    const API_URL = API_BASE + '/v1/contact';
    const sendBtn = $('cm-send');

    async function send() {
      const name = $('cm-name').value.trim();
      const email = $('cm-email').value.trim();
      const subject = $('cm-subject').value.trim();
      const message = $('cm-message').value.trim();
      if (!name) return showErr('Please enter your name.', 'cm-name');
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showErr('Please enter a valid email.', 'cm-email');
      if (!message) return showErr('Please enter a message.', 'cm-message');

      errorBox.classList.remove('show');
      const original = sendBtn.innerHTML;
      sendBtn.disabled = true;
      sendBtn.textContent = 'Sending…';
      try {
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'ngrok-skip-browser-warning': 'true' },
          body: JSON.stringify({ name, email, subject: subject || undefined, message }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          showErr(data.message || 'Could not send your message. Please try again.');
          return;
        }
        body.style.display = 'none';
        success.classList.add('show');
        success.focus();
      } catch (err) {
        showErr('Network error. Please try again, or email ' + SUPPORT + ' directly.');
      } finally {
        sendBtn.disabled = false;
        sendBtn.innerHTML = original;
      }
    }

    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-contact], a[href="#contact"]');
      if (trigger) { e.preventDefault(); open(trigger.getAttribute('data-contact-subject') || ''); return; }
      if (e.target.closest('[data-cm-close]') || e.target === overlay) { close(); }
    });
    document.addEventListener('keydown', (e) => {
      if (!overlay.classList.contains('open')) return;
      if (e.key === 'Escape') { close(); return; }
      if (e.key !== 'Tab') return;
      const focusable = [...overlay.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])')]
        .filter((el) => el.offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0], last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
    form.addEventListener('submit', (e) => { e.preventDefault(); send(); });
  })();
</script>
