---
const { eyebrow, title, subtitle, variant = 'light' } = Astro.props;
---
<section class:list={['page-hero', variant]}>
  <div class="ph-glow" aria-hidden="true"></div>
  <div class="container ph-inner reveal">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 set:html={title} />
    {subtitle && <p set:html={subtitle} />}
    <slot />
  </div>
</section>

<style>
  .page-hero { position: relative; overflow: hidden; padding-block: clamp(56px, 8vw, 96px); text-align: center; }
  .page-hero.light { background: linear-gradient(180deg, var(--bg), var(--mist)); }
  .page-hero.dark { background: radial-gradient(120% 120% at 80% 0%, var(--navy-800), var(--navy-900)); color: var(--on-dark); }
  .page-hero.dark h1 { color: #fff; }
  .ph-glow { position: absolute; top: -40%; right: -10%; width: 55vw; height: 55vw; background: radial-gradient(circle, rgba(43,182,115,.14), transparent 65%); pointer-events: none; }
  .ph-inner { position: relative; max-width: 760px; }
  .ph-inner h1 { margin: 18px 0 16px; }
  .ph-inner p { font-size: 1.15rem; color: var(--text-2); max-width: 620px; margin: 0 auto; }
  .page-hero.dark p { color: var(--on-dark-2); }
  .ph-inner :global(.hero-actions) { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 28px; }
</style>
