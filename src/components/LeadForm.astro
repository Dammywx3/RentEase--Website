---
// Reusable lead-capture form. Submits JSON to `endpoint` (e.g. an API like the
// waitlist's). Fields are configurable. Shows an inline success state.
const {
  endpoint,
  fields = [],
  submitLabel = 'Submit',
  successTitle = 'Thank you!',
  successText = 'We have received your details and will be in touch shortly.',
  note = '',
} = Astro.props;
---
<form class="lead-form" data-lead-form data-endpoint={endpoint} novalidate>
  <div data-content>
    <div class="lf-error" data-error role="alert"></div>
    <div class="lf-grid">
      {fields.map((f) => (
        <div class:list={['lf-group', { full: f.full }]}>
          <label for={f.name}>{f.label}{f.required && <span class="req">*</span>}</label>
          {f.type === 'select' ? (
            <select id={f.name} name={f.name} required={f.required}>
              <option value="" disabled selected>{f.placeholder || 'Select...'}</option>
              {f.options.map((o) => <option value={o}>{o}</option>)}
            </select>
          ) : f.type === 'textarea' ? (
            <textarea id={f.name} name={f.name} placeholder={f.placeholder} required={f.required} rows="4"></textarea>
          ) : (
            <input type={f.type || 'text'} id={f.name} name={f.name} placeholder={f.placeholder} required={f.required} autocomplete={f.autocomplete} />
          )}
        </div>
      ))}
    </div>
    <button type="submit" class="lf-submit" data-submit>
      <span class="lf-btn-text">{submitLabel}</span>
      <span class="lf-spinner" aria-hidden="true"></span>
    </button>
    {note && <p class="lf-note" set:html={note} />}
  </div>

  <div class="lf-success" data-success>
    <span class="lf-success-ico"><i class="fas fa-circle-check"></i></span>
    <h3>{successTitle}</h3>
    <p>{successText}</p>
  </div>
</form>

<style>
  .lead-form { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-xl); padding: clamp(26px, 4vw, 40px); box-shadow: var(--shadow-card); }
  .lf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .lf-group { text-align: left; }
  .lf-group.full { grid-column: 1 / -1; }
  label { display: block; font-size: .82rem; font-weight: 600; color: var(--text-2); margin-bottom: 7px; }
  .req { color: var(--brand-green); margin-left: 2px; }
  input, select, textarea {
    width: 100%; padding: 13px 15px; border: 1px solid var(--border); border-radius: var(--r-md);
    font: inherit; font-size: .95rem; background: var(--surface-2); color: var(--text); outline: none;
    transition: var(--transition); appearance: none; resize: vertical;
  }
  select { background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236F7785' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e"); background-repeat: no-repeat; background-position: right 14px center; background-size: 16px; padding-right: 38px; }
  input:focus, select:focus, textarea:focus { border-color: var(--brand-blue); background: #fff; box-shadow: 0 0 0 4px rgba(30,78,140,.12); }
  input::placeholder, textarea::placeholder { color: var(--text-muted); }
  .error { border-color: var(--danger) !important; background: #FEF2F2 !important; }

  .lf-error { display: none; background: #FEF2F2; border-left: 4px solid var(--danger); color: #B91C1C; font-size: .88rem; padding: 11px 14px; border-radius: var(--r-sm); margin-bottom: 16px; }

  .lf-submit { width: 100%; margin-top: 18px; background: var(--brand-gradient); color: #fff; font-family: var(--font-body); font-weight: 700; font-size: 1rem; padding: 15px; border-radius: var(--r-md); box-shadow: var(--shadow-glow); transition: var(--transition); display: inline-flex; align-items: center; justify-content: center; gap: 10px; cursor: pointer; }
  .lf-submit:hover { transform: translateY(-2px); }
  .lf-submit:disabled { opacity: .7; cursor: not-allowed; transform: none; }
  .lf-spinner { display: none; width: 18px; height: 18px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
  .lf-submit.loading .lf-btn-text { display: none; }
  .lf-submit.loading .lf-spinner { display: inline-block; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .lf-note { text-align: center; color: var(--text-muted); font-size: .82rem; margin-top: 14px; }

  .lf-success { display: none; text-align: center; padding: 18px 0; }
  .lf-success-ico { font-size: 2.6rem; color: var(--brand-green); }
  .lf-success h3 { margin: 12px 0 8px; }
  .lf-success p { color: var(--text-muted); }

  @media (max-width: 520px) { .lf-grid { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll('[data-lead-form]').forEach((form) => {
    const endpoint = (form as HTMLFormElement).dataset.endpoint;
    const btn = form.querySelector('[data-submit]') as HTMLButtonElement;
    const banner = form.querySelector('[data-error]') as HTMLElement;
    const content = form.querySelector('[data-content]') as HTMLElement;
    const success = form.querySelector('[data-success]') as HTMLElement;
    const showErr = (m: string) => { banner.textContent = m; banner.style.display = 'block'; setTimeout(() => (banner.style.display = 'none'), 6000); };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data: Record<string, string> = {};
      let invalid: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement>('[name]').forEach((el) => {
        el.classList.remove('error');
        const v = (el.value || '').trim();
        data[el.name] = v;
        const isEmail = el.type === 'email';
        if ((el.required && !v) || (isEmail && v && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v))) invalid = invalid || el;
      });
      if (invalid) { (invalid as HTMLElement).classList.add('error'); (invalid as HTMLElement).focus(); showErr('Please fill in the required fields correctly.'); return; }

      btn.disabled = true; btn.classList.add('loading');
      try {
        const res = await fetch(endpoint!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        if (!res.ok && res.status !== 409) {
          const d = await res.json().catch(() => ({} as any));
          showErr(d.message || 'Something went wrong. Please try again.');
          return;
        }
        content.style.display = 'none';
        success.style.display = 'block';
      } catch (err) {
        showErr('Network error. Please check your connection and try again.');
      } finally {
        btn.disabled = false; btn.classList.remove('loading');
      }
    });
  });
</script>
