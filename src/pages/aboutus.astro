---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

const does = [
  'Browse only verified listings, checked for real documents and real owners',
  'List residential, commercial and land properties',
  'Connect tenants directly with identity-verified agents and landlords',
  'Chat, schedule viewings and make offers, all inside the app',
  'Pay rent and fees securely through escrow-style payments',
  'Sign legally-binding digital tenancy agreements',
  'Track rent, receipts and renewals from one dashboard',
];

const diff = [
  { icon: 'fa-circle-check', title: 'Verified, always', text: 'Every listing is checked for real documents and owners, and every agent and landlord passes KYC. No ghosts, no fakes.' },
  { icon: 'fa-shield-halved', title: 'Money protected', text: 'Rent and fees move through secure, escrow-style payments and are released only on a clean handover.' },
  { icon: 'fa-file-signature', title: 'Everything digital', text: 'Legally-binding tenancy agreements you sign from your phone and access anytime, no paperwork.' },
  { icon: 'fa-mobile-screen-button', title: 'All in one place', text: 'Search, chat, viewings, offers, payments and management for tenants, agents and landlords, in one app.' },
];

const serve = [
  { icon: 'fa-house-user', title: 'Tenants', text: 'Search properties easily, explore options, communicate with verified agents, and move through the rental process with confidence.' },
  { icon: 'fa-user-tie', title: 'Agents', text: 'Showcase listings, manage inquiries, respond to offers, and handle client engagement more efficiently.' },
  { icon: 'fa-building-user', title: 'Landlords & Managers', text: 'Present properties professionally, track interest, manage available units, and connect with serious prospects.' },
];

const values = [
  { icon: 'fa-shield-halved', title: 'Transparency', text: 'Clear information and verified data at every step.' },
  { icon: 'fa-bolt', title: 'Simplicity', text: 'Tools built around real rental workflows, not paperwork.' },
  { icon: 'fa-handshake', title: 'Trust', text: 'Verification and accountability for everyone involved.' },
  { icon: 'fa-arrow-trend-up', title: 'Progress', text: 'Continuously improving our technology and service.' },
];
---
<Base
  title="About RentEase 9ja | Simplifying Real Estate in Nigeria"
  description="RentEase 9ja is a modern property platform built to make searching, listing, and renting easier, faster, and more transparent across Nigeria."
  active="/aboutus"
>
  <PageHero
    eyebrow="About us"
    title="Simplifying real estate in <span class='gradient-text'>Nigeria.</span>"
    subtitle="RentEase 9ja is a modern real estate platform built to make property search, listing, and rental transactions easier, faster, and more transparent."
  />

  <section class="section section--surface">
    <div class="container narrow">
      <div class="prose reveal">
        <p>RentEase 9ja was born out of a painful truth: renting in Nigeria is broken. Too many people lose money to fake listings, ghost agents and cash payments that simply vanish, with no agreements, no receipts, and no one to hold accountable.</p>
        <p>So we set out to build the trust layer Nigerian real estate has always lacked, one platform where every listing is verified, every agent and landlord is identity-checked, every payment is protected, and every agreement is digital. From the first search to the signed lease, RentEase 9ja makes renting, buying and selling property safe, transparent and stress-free, for tenants, agents and landlords alike.</p>
      </div>
      <img src="/image1.webp" alt="The RentEase 9ja experience" class="media reveal" loading="lazy" width="900" height="540" />
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Why RentEase 9ja</span>
        <h2>Trust, built into every step</h2>
        <p>We didn't just digitise property listings, we rebuilt the whole process around safety and accountability.</p>
      </div>
      <div class="grid grid-4">
        {diff.map((d, i) => (
          <div class="diff reveal" data-delay={i % 4}>
            <div class="d-icon"><i class={`fas ${d.icon}`}></i></div>
            <h3>{d.title}</h3>
            <p>{d.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container narrow">
      <figure class="founder card reveal">
        <img src="/team/damilare.webp" alt="Damilare V Adebayo, Founder & CEO of RentEase 9ja" class="founder-photo" width="120" height="120" loading="lazy" />
        <div class="founder-body">
          <span class="eyebrow">A note from our founder</span>
          <blockquote>I've watched too many people in Nigeria lose their hard-earned money to fake listings and agents who vanish. I built RentEase 9ja so that never has to happen again, where every listing is verified, every naira is protected, and every agreement is real. This is more than an app to us; it's a promise.</blockquote>
          <figcaption><strong>Damilare V Adebayo</strong><span>Founder, CEO &amp; CTO</span></figcaption>
        </div>
      </figure>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="grid grid-2 mv">
        <div class="mv-card card reveal">
          <span class="eyebrow">Our mission</span>
          <p>To make property in Nigeria safe and accessible for everyone, by replacing fraud, guesswork and paperwork with verified listings, secure payments and digital agreements on one trusted platform.</p>
        </div>
        <div class="mv-card card reveal" data-delay="1">
          <span class="eyebrow">Our vision</span>
          <p>To become the most trusted property platform in Africa, where no one ever has to fear being defrauded when they look for a home, list a property, or close a deal.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">What we do</span>
        <h2>One platform for the whole journey</h2>
      </div>
      <ul class="does grid grid-2 reveal">
        {does.map((d) => (<li><i class="fas fa-circle-check"></i> {d}</li>))}
      </ul>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Who we serve</span>
        <h2>Built for everyone in the deal</h2>
      </div>
      <div class="grid grid-3">
        {serve.map((s, i) => (
          <div class="serve card reveal" data-delay={i % 3}>
            <div class="s-icon"><i class={`fas ${s.icon}`}></i></div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">What we stand for</span>
        <h2>The future of renting in Nigeria</h2>
        <p>We are not just building another property app, we are building a smarter, more trusted rental ecosystem.</p>
      </div>
      <div class="grid grid-4">
        {values.map((v, i) => (
          <div class="value reveal" data-delay={i % 4}>
            <div class="v-icon"><i class={`fas ${v.icon}`}></i></div>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container narrow">
      <div class="contact card reveal">
        <h2>Get in touch</h2>
        <p>Whether you have a question, need support, or want to partner with us, we'd love to hear from you.</p>
        <ul class="contact-list">
          <li><i class="fas fa-headset"></i> Support: <a href="mailto:support@rentease9ja.com">support@rentease9ja.com</a></li>
          <li><i class="fas fa-circle-info"></i> General: <a href="mailto:info@rentease9ja.com">info@rentease9ja.com</a></li>
          <li><i class="fas fa-handshake"></i> Partnerships: <a href="mailto:partnerships@rentease9ja.com">partnerships@rentease9ja.com</a></li>
          <li><i class="fas fa-location-dot"></i> Nigeria · Mon–Fri, 9:00 AM – 5:00 PM</li>
        </ul>
        <a href="#contact" class="btn btn-primary" style="margin-top:22px;">Send us a message <i class="fas fa-arrow-right"></i></a>
      </div>
    </div>
  </section>

  <CtaBand title="Be part of the journey." text="Join the waitlist and help us build a better property experience for Nigeria." />
</Base>

<style>
  .narrow { max-width: 860px; }
  .prose p { font-size: 1.15rem; color: var(--text-2); line-height: 1.8; }
  .media { width: 100%; border-radius: var(--r-xl); margin-top: 32px; box-shadow: var(--shadow-card); aspect-ratio: 5 / 3; object-fit: cover; }
  .mv-card { padding: 34px 30px; }
  .mv-card p { color: var(--text-2); font-size: 1.08rem; line-height: 1.7; margin-top: 14px; }
  .does { gap: 14px 30px; }
  .does li { display: flex; align-items: flex-start; gap: 12px; color: var(--text-2); font-weight: 500; }
  .does i { color: var(--brand-green); margin-top: 3px; }
  .founder { display: flex; gap: 30px; align-items: center; padding: 36px 34px; background: var(--brand-gradient-soft); border: 1px solid var(--border); }
  .founder-photo { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; flex: none; box-shadow: var(--shadow-card); }
  .founder-body blockquote { font-size: 1.14rem; line-height: 1.7; color: var(--text); font-style: italic; margin: 12px 0 16px; }
  .founder figcaption strong { display: block; font-family: var(--font-display); font-weight: 800; color: var(--text); }
  .founder figcaption span { color: var(--text-muted); font-size: .92rem; }
  @media (max-width: 640px) { .founder { flex-direction: column; text-align: center; padding: 30px 24px; } }

  .diff { text-align: center; }
  .d-icon { width: 60px; height: 60px; border-radius: var(--r-md); display: grid; place-items: center; font-size: 1.4rem; color: #fff; background: var(--brand-gradient); margin: 0 auto 16px; box-shadow: var(--shadow-glow); }
  .diff h3 { margin-bottom: 6px; font-size: 1.12rem; color: #fff; }
  .diff p { color: var(--on-dark-2); font-size: .95rem; line-height: 1.65; }
  .serve { padding: 30px 28px; }
  .s-icon { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; font-size: 1.35rem; color: var(--brand-blue); background: var(--brand-gradient-soft); margin-bottom: 16px; }
  .serve h3 { margin-bottom: 8px; }
  .serve p { color: var(--text-muted); }
  .value { text-align: center; }
  .v-icon { width: 60px; height: 60px; border-radius: var(--r-md); display: grid; place-items: center; font-size: 1.4rem; color: #fff; background: var(--brand-gradient); margin: 0 auto 16px; }
  .value h3 { margin-bottom: 6px; font-size: 1.15rem; }
  .value p { color: var(--text-muted); font-size: .95rem; }
  .contact { padding: 40px 36px; }
  .contact h2 { margin-bottom: 10px; }
  .contact > p { color: var(--text-muted); margin-bottom: 22px; }
  .contact-list { display: flex; flex-direction: column; gap: 14px; }
  .contact-list li { display: flex; align-items: center; gap: 12px; color: var(--text-2); }
  .contact-list i { color: var(--brand-blue); width: 20px; }
  .contact-list a { color: var(--brand-blue); font-weight: 600; }
</style>
