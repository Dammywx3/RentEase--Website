---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const market = [
  { value: '$3B+', label: 'Annual rental market in Nigeria', note: 'verify' },
  { value: '200M+', label: 'Population, rapidly urbanising' },
  { value: '75%+', label: 'Renters without trusted tools', note: 'verify' },
  { value: '90%+', label: 'Market still offline & informal', note: 'verify' },
];

const traction = [
  { value: '800+', label: 'Waitlist signups' },
  { value: '14', label: 'Cities at launch' },
  { value: '35%', label: 'Month-over-month growth', note: 'verify' },
  { value: '120+', label: 'Agents & landlords onboarding', note: 'verify' },
];

const pillars = [
  { icon: 'fa-shield-halved', title: 'Trust as the moat', text: 'Verification, escrow-style payments, and digital agreements create defensibility competitors can’t copy overnight.' },
  { icon: 'fa-layer-group', title: 'End-to-end platform', text: 'Search, chat, viewings, payments, and contracts in one app, capturing the full transaction, not just leads.' },
  { icon: 'fa-coins', title: 'Multiple revenue lines', text: 'Listing & subscription fees, transaction take-rate, premium developer tools, and embedded financial services.' },
  { icon: 'fa-arrow-trend-up', title: 'Network effects', text: 'More verified listings attract more seekers, which attracts more agents and developers, a compounding flywheel.' },
];
---
<Base
  title="Investors | Building the Trust Layer for Nigerian Real Estate | RentEase 9ja"
  description="RentEase 9ja is building the verified, end-to-end property platform for Nigeria. Explore the market opportunity, traction, and how to request our investor deck."
  active="/investors"
>
  <PageHero
    variant="dark"
    eyebrow="Investors"
    title="Building the trust layer for <span class='gradient-text'>Nigerian real estate.</span>"
    subtitle="A massive, fragmented market starved of trust, and the end-to-end platform built to own it."
  >
    <div class="hero-actions">
      <a href="mailto:partnerships@rentease9ja.com?subject=Investor%20enquiry%20%E2%80%94%20request%20deck" class="btn btn-primary">Request investor deck <i class="fas fa-arrow-right"></i></a>
      <a href="/aboutus" class="btn btn-on-dark">Read our story</a>
    </div>
  </PageHero>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">The opportunity</span>
        <h2>A huge market, ready for trust</h2>
        <p>Nigerian real estate is enormous and overwhelmingly offline, informal, and fraud-prone. Whoever makes it safe and digital wins.</p>
      </div>
      <div class="grid grid-4">
        {market.map((m, i) => (
          <div class="m-stat reveal" data-delay={i % 4}>
            <div class="m-val gradient-text">{m.value}</div>
            <div class="m-label">{m.label}</div>
          </div>
        ))}
      </div>
      <p class="disclaimer reveal">Market sizing figures are working estimates. Confirm them against a cited source before sharing publicly.</p>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Why we win</span>
        <h2>A defensible, compounding platform</h2>
      </div>
      <div class="grid grid-2">
        {pillars.map((p, i) => (
          <div class="pillar card reveal" data-delay={i % 2}>
            <div class="p-icon"><i class={`fas ${p.icon}`}></i></div>
            <div><h3>{p.title}</h3><p>{p.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Traction</span>
        <h2>Momentum before launch</h2>
      </div>
      <div class="grid grid-4">
        {traction.map((t, i) => (
          <div class="m-stat reveal" data-delay={i % 4}>
            <div class="m-val gradient-text">{t.value}</div>
            <div class="m-label">{t.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="invest-cta-band">
    <div class="container reveal">
      <h2>Let's build the future of housing in Nigeria.</h2>
      <p>We're raising to accelerate launch and onboarding. Request the deck and let's talk.</p>
      <a href="mailto:partnerships@rentease9ja.com?subject=Investor%20enquiry%20%E2%80%94%20request%20deck" class="btn btn-light">Request investor deck <i class="fas fa-arrow-right"></i></a>
    </div>
  </section>
</Base>

<style>
  .m-stat { text-align: center; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 30px 18px; box-shadow: var(--shadow-sm); }
  .m-val { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.55rem, 3vw, 2.1rem); letter-spacing: -.03em; }
  .m-label { color: var(--text-muted); font-size: .92rem; margin-top: 8px; }
  .disclaimer { text-align: center; color: var(--text-muted); font-size: .85rem; margin-top: 28px; }
  .disclaimer code { background: var(--surface-2); border: 1px solid var(--border); padding: 1px 6px; border-radius: 6px; }
  .pillar { display: flex; gap: 18px; align-items: flex-start; padding: 28px; }
  .p-icon { flex-shrink: 0; width: 52px; height: 52px; border-radius: var(--r-md); display: grid; place-items: center; font-size: 1.25rem; color: #fff; background: var(--brand-gradient); }
  .pillar h3 { margin-bottom: 6px; }
  .pillar p { color: var(--text-muted); }
  .invest-cta-band { background: var(--brand-gradient); color: #fff; padding-block: clamp(56px, 8vw, 96px); text-align: center; }
  .invest-cta-band h2 { color: #fff; }
  .invest-cta-band p { color: rgba(255,255,255,.92); font-size: 1.1rem; margin: 14px 0 28px; }
</style>
