---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const market = [
  { value: '4', label: 'Property roles supported' },
  { value: '3', label: 'Client platforms' },
  { value: '1', label: 'Shared transaction record' },
  { value: 'NG', label: 'Initial operating market' },
];

const traction = [
  { value: '800+', label: 'Early-access registrations' },
  { value: 'Mobile', label: 'Tenant and property workflows' },
  { value: 'Desktop', label: 'Agent operating workspace' },
  { value: 'Admin', label: 'Platform oversight tools' },
];

const pillars = [
  { icon: 'fa-shield-halved', title: 'Transaction controls', text: 'Participant checks, protected payment steps, and digital agreements preserve evidence across the property journey.' },
  { icon: 'fa-layer-group', title: 'Connected workflow', text: 'Search, communication, viewings, payments, and agreements use one shared transaction record.' },
  { icon: 'fa-coins', title: 'Commercial model', text: 'Planned revenue includes subscriptions, transaction services, and tools for professional property operators.' },
  { icon: 'fa-arrow-trend-up', title: 'Multi-role product', text: 'Tenants, agents, landlords, and developers participate in the same property network through role-specific interfaces.' },
];
---
<Base
  title="Investors | Building the Trust Layer for Nigerian Real Estate | RentEase 9ja"
  description="RentEase 9ja is building a property transaction platform for Nigeria. Review the product scope and request investor materials."
  active="/investors"
>
  <PageHero
    variant="dark"
    eyebrow="Investors"
    title="A transaction platform for <span class='gradient-text'>Nigerian property.</span>"
    subtitle="RentEase 9ja connects discovery, communication, payment records, agreements, and property operations across one product system."
  >
    <div class="hero-actions">
      <a href="/investor-access" class="btn btn-primary">Request investor deck <i class="fas fa-arrow-right"></i></a>
      <a href="/aboutus" class="btn btn-on-dark">Read our story</a>
    </div>
  </PageHero>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Product scope</span>
        <h2>One system across the transaction</h2>
        <p>The public page shows current product scope only. Sourced market analysis and commercial assumptions are available in the investor materials.</p>
      </div>
      <div class="grid grid-4">
        {market.map((m, i) => (
          <div class="m-stat reveal" data-delay={i % 4}>
            <div class="m-val">{m.value}</div>
            <div class="m-label">{m.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Operating model</span>
        <h2>Product foundations for long-term value</h2>
      </div>
      <div class="grid grid-2">
        {pillars.map((p, i) => (
          <div class="pillar card reveal" data-delay={i % 2}>
            <div class="p-icon"><i class={`fas ${p.icon}`}></i></div>
            <div><h3>{p.title}</h3><p>{p.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Traction</span>
        <h2>Momentum before launch</h2>
      </div>
      <div class="grid grid-4">
        {traction.map((t, i) => (
          <div class="m-stat reveal" data-delay={i % 4}>
            <div class="m-val">{t.value}</div>
            <div class="m-label">{t.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="invest-cta-band">
    <div class="container reveal">
      <h2>Review the investment materials.</h2>
      <p>Request access to the sourced market analysis, operating model, and current fundraising information.</p>
      <a href="/investor-access" class="btn btn-light">Request investor deck <i class="fas fa-arrow-right"></i></a>
    </div>
  </section>
</Base>

<style>
  .m-stat { text-align: left; border-top: 2px solid var(--brand-blue); padding: 24px 0; }
  .m-val { font-family: var(--font-display); font-weight: 700; font-size: 1.7rem; letter-spacing: 0; color: var(--text); }
  .m-label { color: var(--text-muted); font-size: .92rem; margin-top: 8px; }
  .disclaimer { text-align: center; color: var(--text-muted); font-size: .85rem; margin-top: 28px; }
  .disclaimer code { background: var(--surface-2); border: 1px solid var(--border); padding: 1px 6px; border-radius: 6px; }
  .pillar { display: flex; gap: 18px; align-items: flex-start; padding: 28px; }
  .p-icon { flex-shrink: 0; width: 52px; height: 52px; border-radius: var(--r-md); display: grid; place-items: center; font-size: 1.25rem; color: #fff; background: var(--brand-gradient); }
  .pillar h3 { margin-bottom: 6px; }
  .pillar p { color: var(--text-muted); }
  .invest-cta-band { background: var(--brand-blue); color: #fff; padding-block: clamp(56px, 8vw, 88px); text-align: center; }
  .invest-cta-band h2 { color: #fff; }
  .invest-cta-band p { color: rgba(255,255,255,.92); font-size: 1.1rem; margin: 14px 0 28px; }
</style>
