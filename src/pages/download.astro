---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import DesktopDownload from '../components/DesktopDownload.astro';
import DeviceLaptop from '../components/DeviceLaptop.astro';
import { WEB_APP_URL } from '../config';

const features = [
  { icon: 'fa-bolt', title: 'Faster on desktop', text: 'A roomy, keyboard-first workspace for managing listings, leads and payouts at speed.' },
  { icon: 'fa-table-columns', title: 'Everything in view', text: 'Dashboard, applications, viewings, registry and wallet, side by side on a big screen.' },
  { icon: 'fa-bell', title: 'Native notifications', text: 'Get desktop alerts for new leads, applications and payments the moment they land.' },
  { icon: 'fa-shield-halved', title: 'Same secure account', text: 'Signs in with your RentEase 9ja account, verified, encrypted, and always in sync.' },
];
const requirements = [
  { os: 'macOS', detail: 'macOS 11 Big Sur or later · Apple silicon & Intel' },
  { os: 'Windows', detail: 'Windows 10 or 11 · 64-bit' },
  { os: 'Linux', detail: 'Most modern distros · AppImage (x86_64)' },
];
---
<Base
  title="Download the RentEase 9ja Desktop App | Mac, Windows & Linux"
  description="Get the RentEase 9ja desktop workspace for agents and landlords. Available for macOS, Windows and Linux."
  active="/download"
>
  <PageHero
    eyebrow="Desktop app"
    title="The agent workspace, <span class='gradient-text'>on your desktop.</span>"
    subtitle="A full-screen workspace for agents and landlords, manage listings, leads, applications, viewings, payouts and registry, all from your computer."
  />

  <section class="section section--surface">
    <div class="container narrow reveal">
      <DesktopDownload />

      <div class="webapp">
        <div class="webapp-or"><span>or, no install needed</span></div>
        <a class="webapp-card" href={WEB_APP_URL} target="_blank" rel="noopener">
          <span class="webapp-ic"><i class="fas fa-globe"></i></span>
          <span class="webapp-txt">
            <strong>Use the web app in your browser</strong>
            <span>Sign up and start straight away, nothing to download or install.</span>
          </span>
          <i class="fas fa-arrow-up-right-from-square webapp-go"></i>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="dl-shot reveal"><DeviceLaptop /></div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Why desktop</span>
        <h2>Built for getting things done</h2>
      </div>
      <div class="grid grid-4">
        {features.map((f, i) => (
          <div class="dlf reveal" data-delay={i % 4}>
            <div class="dlf-icon"><i class={`fas ${f.icon}`}></i></div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">System requirements</span>
        <h2>What you need</h2>
      </div>
      <ul class="reqs reveal">
        {requirements.map((r) => (<li><strong>{r.os}</strong><span>{r.detail}</span></li>))}
      </ul>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">First time opening the app?</span>
        <h2>Getting past the security prompt</h2>
        <p>Our early builds aren't code-signed yet, so your system may warn you the first time you open it. It's safe — here's how.</p>
      </div>
      <div class="help">
        <div class="help-row reveal"><span class="help-os"><i class="fab fa-apple" aria-hidden="true"></i> macOS</span><p>Right-click (or Control-click) the app and choose <strong>Open</strong>, then <strong>Open</strong> again in the dialog. You only need to do this once.</p></div>
        <div class="help-row reveal" data-delay="1"><span class="help-os"><i class="fab fa-windows" aria-hidden="true"></i> Windows</span><p>If a Windows SmartScreen prompt appears, click <strong>More info</strong>, then <strong>Run anyway</strong>.</p></div>
        <div class="help-row reveal" data-delay="2"><span class="help-os"><i class="fab fa-linux" aria-hidden="true"></i> Linux</span><p>Make the AppImage executable (<code>chmod +x</code>, or Properties → Permissions → Allow executing), then run it. Or install the <strong>.deb</strong> / <strong>.rpm</strong> with your package manager.</p></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 840px; }
  .webapp { margin-top: 30px; }
  .webapp-or { display: flex; align-items: center; gap: 14px; color: var(--text-muted); font-size: .82rem; margin-bottom: 18px; }
  .webapp-or::before, .webapp-or::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  .webapp-card { display: flex; align-items: center; gap: 16px; padding: 18px 22px; border-radius: var(--r-lg); border: 1px solid var(--border); background: var(--brand-gradient-soft); box-shadow: var(--shadow-sm); transition: var(--transition); }
  .webapp-card:hover { transform: translateY(-3px); border-color: rgba(30,78,140,.3); box-shadow: var(--shadow-card); }
  .webapp-ic { flex: none; width: 46px; height: 46px; border-radius: var(--r-md); display: grid; place-items: center; font-size: 1.25rem; color: #fff; background: var(--brand-gradient); }
  .webapp-txt { flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .webapp-txt strong { color: var(--text); font-size: 1.02rem; }
  .webapp-txt span { color: var(--text-muted); font-size: .9rem; }
  .webapp-go { color: var(--brand-blue); font-size: 1rem; }
  @media (max-width: 480px) { .webapp-card { flex-wrap: wrap; } .webapp-go { display: none; } }

  .dl-shot { display: flex; justify-content: center; position: relative; z-index: 1; }
  .dlf { text-align: center; }
  .dlf-icon { width: 56px; height: 56px; border-radius: var(--r-md); display: grid; place-items: center; font-size: 1.35rem; color: #fff; background: var(--brand-gradient); margin: 0 auto 14px; }
  .dlf h3 { margin-bottom: 6px; font-size: 1.08rem; }
  .dlf p { color: var(--text-muted); font-size: .92rem; }
  .reqs { display: flex; flex-direction: column; gap: 12px; max-width: 620px; margin: 0 auto; }
  .reqs li { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 15px 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); box-shadow: var(--shadow-sm); }
  .reqs strong { color: var(--text); }
  .reqs span { color: var(--text-muted); text-align: right; font-size: .92rem; }
  .help { display: flex; flex-direction: column; gap: 12px; max-width: 680px; margin: 0 auto; }
  .help-row { display: flex; gap: 18px; align-items: flex-start; padding: 18px 22px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); box-shadow: var(--shadow-sm); }
  .help-os { flex: none; width: 110px; font-weight: 700; color: var(--text); display: inline-flex; align-items: center; gap: 8px; }
  .help-os i { font-size: 1.1rem; }
  .help-row p { color: var(--text-2); font-size: .95rem; line-height: 1.6; }
  .help-row code { background: var(--surface-2); border: 1px solid var(--border); border-radius: 5px; padding: 1px 6px; font-size: .88em; }
  @media (max-width: 560px) { .help-row { flex-direction: column; gap: 8px; } .help-os { width: auto; } }
</style>
