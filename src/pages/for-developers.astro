---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

const benefits = [
  { icon: 'fa-city', title: 'Showcase whole estates', text: 'Present entire developments, phases, unit types, floor plans, and availability, in one branded, verified storefront.' },
  { icon: 'fa-file-contract', title: 'Document-verified plots', text: 'C of O, governor’s consent, and survey docs are checked and displayed, so buyers trust your titles instantly.' },
  { icon: 'fa-chart-line', title: 'Buyer demand analytics', text: 'See which units attract the most interest, where buyers come from, and what converts, and adjust pricing fast.' },
  { icon: 'fa-bullhorn', title: 'Structured buyer leads', text: 'Capture and manage buyer enquiries and offers in one workspace without relying on disconnected channels.' },
  { icon: 'fa-headset', title: 'Dedicated sales support', text: 'A dedicated account team helps you onboard, list, and close, plus featured placement during launch campaigns.' },
  { icon: 'fa-handshake-angle', title: 'Flexible payment plans', text: 'Offer instalment and off-plan payment options buyers can complete securely, with every step tracked in-app.' },
];

const steps = [
  { n: '01', title: 'Partner with us', text: 'Tell us about your projects. We verify your company and set up your developer account.' },
  { n: '02', title: 'Publish your estates', text: 'We help you list developments with verified docs, media, and unit inventory.' },
  { n: '03', title: 'Sell faster', text: 'Receive qualified leads, manage offers, and close securely, with analytics guiding every decision.' },
];
---
<Base
  title="For Property Developers | Sell Estates Faster | RentEase 9ja"
  description="Sell estates and plots faster on RentEase 9ja. Verified storefronts, document checks, buyer analytics, and qualified leads built for Nigerian property developers."
  active="/for-developers"
>
  <PageHero
    eyebrow="For property developers"
    title="Sell your estates faster, <span class='gradient-text'>with trust built in.</span>"
    subtitle="Present development inventory and available documents, then manage buyer interest, offers, and payment plans in one workspace."
  >
    <div class="hero-actions">
      <a href="/partners" class="btn btn-primary">Become a partner <i class="fas fa-arrow-right"></i></a>
      <a href="/waitlist" class="btn btn-ghost">Join the waitlist</a>
    </div>
  </PageHero>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Built for scale</span>
        <h2>Everything you need to move inventory</h2>
      </div>
      <div class="grid grid-3">
        {benefits.map((b, i) => (
          <div class="benefit card reveal" data-delay={i % 3}>
            <div class="b-icon"><i class={`fas ${b.icon}`}></i></div>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Getting started</span>
        <h2>Live in three steps</h2>
      </div>
      <div class="grid grid-3">
        {steps.map((s, i) => (
          <div class="dstep reveal" data-delay={i % 3}>
            <span class="dnum gradient-text">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Let's sell your next development."
    text="Partner with RentEase 9ja and put your estates in front of verified buyers across Nigeria."
    primaryLabel="Become a partner"
    primaryHref="/partners"
    secondaryLabel="See how it works"
    secondaryHref="/how-it-works"
  />
</Base>

<style>
  .benefit { padding: 30px 28px; }
  .b-icon { width: 56px; height: 56px; border-radius: var(--r-md); display: grid; place-items: center; font-size: 1.4rem; color: #fff; background: var(--brand-gradient); margin-bottom: 18px; }
  .benefit h3 { margin-bottom: 8px; }
  .benefit p { color: var(--text-muted); }
  .dstep { border-top: 2px solid var(--brand-blue); padding: 30px 0; }
  .dnum { font-family: var(--font-display); font-weight: 800; font-size: 2.1rem; letter-spacing: 0; display: block; margin-bottom: 8px; }
  .dstep h3 { margin-bottom: 8px; }
  .dstep p { color: var(--text-muted); }
</style>
