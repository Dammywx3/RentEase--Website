---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

const founders = [
  { initials: 'DA', name: 'Damilare V Adebayo', role: 'Founder and Chief Executive', bio: 'Founder of RentEase 9ja, leading product and engineering across listing workflows, communication, payment records, and digital agreements. His focus is reducing fraud risk and making property transactions easier to follow.', photo: '/team/damilare.webp', x: 'https://x.com/damilareomoadebayo', instagram: 'https://instagram.com/damilareomoadebayo' },
  { initials: 'OB', name: 'Ola Ben Olowasogo', role: 'Co-founder & COO', bio: 'Co-founder of RentEase 9ja, focused on bringing the vision to market and growing a trusted network of agents, landlords, and tenants across Nigeria.', photo: '/team/ola.webp', x: 'https://x.com/ola_ben_', instagram: 'https://www.instagram.com/olaben_8' },
];

// Roles are best-guess placeholders — adjust to each person's actual role.
const team = [
  { initials: 'AA', name: 'Ayomide T Ademilua', role: 'Operations & Support', photo: '/team/ayomide.webp' },
  { initials: 'OA', name: 'Oluwakayode O Afolabi', role: 'Property Acquisition Officer', photo: '/team/afolabi.webp' },
  { initials: 'AO', name: 'Abdulafeez O Abdulhakeem', role: 'Agents Relations Officer', photo: '/team/abdulafeez.webp' },
  { initials: 'IO', name: 'Iyanuoluwa Osunniran', role: 'Secretary', photo: '/team/iyanuoluwa.webp' },
  { initials: 'AG', name: 'Atinuke J Ogunleye', role: 'Customer Support Lead', photo: '/team/atinuke.webp' },
  { initials: 'ST', name: 'Stephen Temitope', role: 'Head of Media', photo: '/team/stephen.webp' },
  { initials: 'FI', name: 'Felix E Ibitoye', role: 'Marketing Manager', photo: '/team/felix.webp' },
  { initials: 'TA', name: 'Timileyin V Amodu', role: 'Head of Property Partnership', photo: '/team/timileyin.webp' },
];

---
<Base
  title="Meet the Team | RentEase 9ja"
  description="Meet the founders and team building the RentEase 9ja property transaction platform in Nigeria."
  active="/team"
>
  <PageHero
    eyebrow="Our people"
    title="The team building <span class='gradient-text'>RentEase 9ja.</span>"
    subtitle="A focused product and operations team working to make Nigerian property transactions clearer and easier to document."
  />

  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Founders</span>
        <h2>The people behind RentEase 9ja</h2>
      </div>
      <div class="grid grid-2 founders">
        {founders.map((f, i) => (
          <div class="founder card reveal" data-delay={i % 2}>
            {f.photo
              ? <img class="avatar" src={f.photo} alt={f.name} width="96" height="96" loading="lazy" />
              : <div class="avatar avatar--initials">{f.initials}</div>}
            <div class="f-body">
              <h3>{f.name}</h3>
              <p class="role">{f.role}</p>
              <p class="bio">{f.bio}</p>
              {(f.x || f.instagram) && (
                <div class="f-socials">
                  {f.x && <a href={f.x} target="_blank" rel="noopener" aria-label={`${f.name} on X`}><i class="fab fa-x-twitter"></i></a>}
                  {f.instagram && <a href={f.instagram} target="_blank" rel="noopener" aria-label={`${f.name} on Instagram`}><i class="fab fa-instagram"></i></a>}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">The team</span>
        <h2>Product, operations, and partnerships</h2>
      </div>
      <div class="grid grid-3 team-grid">
        {team.map((t, i) => (
          <div class="member reveal" data-delay={i % 4}>
            {t.photo
              ? <img class="avatar" src={t.photo} alt={t.name} width="88" height="88" loading="lazy" />
              : <div class="avatar avatar--initials sm">{t.initials}</div>}
            <h3>{t.name}</h3>
            <p class="role">{t.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Want to build with us?"
    text="We're a small team with big ambitions for Nigerian real estate. If that excites you, reach out."
    primaryLabel="Get in touch"
    primaryHref="#contact"
    secondaryLabel="Read our story"
    secondaryHref="/aboutus"
  />
</Base>

<style>
  .founders { gap: clamp(20px, 3vw, 32px); }
  .founder { display: flex; gap: 22px; align-items: flex-start; padding: 30px 28px; }
  .f-body h3 { margin-bottom: 2px; }
  .avatar { width: 96px; height: 96px; border-radius: 6px; flex-shrink: 0; object-fit: cover; box-shadow: var(--shadow-sm); }
  .avatar--initials { display: grid; place-items: center; background: var(--brand-gradient); color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 1.8rem; letter-spacing: 0; }
  .avatar--initials.sm { width: 88px; height: 88px; font-size: 1.6rem; margin: 0 auto 16px; }
  .role { color: var(--brand-blue); font-weight: 700; font-size: .92rem; margin-bottom: 12px; }
  .bio { color: var(--text-muted); font-size: .95rem; line-height: 1.65; margin-bottom: 14px; }
  .f-socials { display: flex; gap: 10px; }
  .f-socials a { width: 38px; height: 38px; border-radius: 4px; display: grid; place-items: center; background: var(--surface-2); border: 1px solid var(--border); color: var(--brand-blue); transition: var(--transition); }
  .f-socials a:hover { background: var(--brand-blue); color: #fff; border-color: var(--brand-blue); }

  /* Flex (not grid) so any count centers cleanly — no orphaned last-row card */
  .team-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(20px, 2.4vw, 36px); max-width: 860px; margin-inline: auto; }
  .member { flex: 0 0 200px; max-width: 200px; }
  @media (max-width: 480px) { .member { flex-basis: 72%; max-width: 72%; } }
  .member { text-align: center; }
  .member .avatar { width: 88px; height: 88px; border-radius: 6px; object-fit: cover; margin: 0 auto 16px; display: block; }
  .member h3 { font-size: 1.1rem; margin-bottom: 2px; }
  .member .role { margin-bottom: 0; }

  @media (max-width: 560px) { .founder { flex-direction: column; align-items: center; text-align: center; } .f-socials { justify-content: center; } }
</style>
