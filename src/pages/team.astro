---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

// NOTE: Replace names, roles, bios, photos and links with real data.
// For photos, drop images in public/team/ and set `photo: '/team/name.webp'`.
const founders = [
  { initials: 'AD', name: 'Founder Name', role: 'Founder & CEO', bio: 'Leads product and vision. [Replace with a short founder bio: background, why RentEase 9ja, what they own.]', photo: '', x: '#', linkedin: '#' },
  { initials: 'CO', name: 'Co-founder Name', role: 'Co-founder & CTO', bio: 'Leads engineering and the platform. [Replace with a short bio.]', photo: '', x: '#', linkedin: '#' },
];

const team = [
  { initials: 'TM', name: 'Team Member', role: 'Head of Operations', photo: '' },
  { initials: 'TM', name: 'Team Member', role: 'Product Designer', photo: '' },
  { initials: 'TM', name: 'Team Member', role: 'Growth & Partnerships', photo: '' },
  { initials: 'TM', name: 'Team Member', role: 'Trust & Verification Lead', photo: '' },
];

const posts = [
  { tag: 'Update', date: 'Coming soon', title: 'Why we are building RentEase 9ja', excerpt: '[Replace: a short post about the trust gap in Nigerian real estate and our mission.]', href: '#' },
  { tag: 'Product', date: 'Coming soon', title: 'How verification works on RentEase 9ja', excerpt: '[Replace: a post explaining KYC, document checks, and escrow.]', href: '#' },
  { tag: 'Community', date: 'Coming soon', title: 'Meet the agents joining at launch', excerpt: '[Replace: a post spotlighting early agents and landlords.]', href: '#' },
];
---
<Base
  title="Meet the Team | RentEase 9ja"
  description="Meet the founders and team building RentEase 9ja, the first end-to-end digital property platform in Nigeria."
  active="/team"
>
  <PageHero
    eyebrow="Our people"
    title="The team building the future of <span class='gradient-text'>renting in Nigeria.</span>"
    subtitle="A small, focused team obsessed with making property safe, simple, and transparent for every Nigerian."
  />

  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Founders</span>
        <h2>The people behind RentEase 9ja</h2>
      </div>
      <div class="grid grid-2 founders">
        {founders.map((f, i) => (
          <div class="founder card reveal" data-delay={i % 2}>
            {f.photo
              ? <img class="avatar" src={f.photo} alt={f.name} width="96" height="96" loading="lazy" />
              : <div class="avatar avatar--initials">{f.initials}</div>}
            <div class="f-body">
              <h3>{f.name}</h3>
              <p class="role">{f.role}</p>
              <p class="bio">{f.bio}</p>
              <div class="f-socials">
                <a href={f.x} target="_blank" rel="noopener" aria-label={`${f.name} on X`}><i class="fab fa-x-twitter"></i></a>
                <a href={f.linkedin} target="_blank" rel="noopener" aria-label={`${f.name} on LinkedIn`}><i class="fab fa-linkedin-in"></i></a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">The team</span>
        <h2>Builders, designers & operators</h2>
      </div>
      <div class="grid grid-4">
        {team.map((t, i) => (
          <div class="member reveal" data-delay={i % 4}>
            {t.photo
              ? <img class="avatar" src={t.photo} alt={t.name} width="88" height="88" loading="lazy" />
              : <div class="avatar avatar--initials sm">{t.initials}</div>}
            <h3>{t.name}</h3>
            <p class="role">{t.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">From the team</span>
        <h2>Notes, updates & stories</h2>
        <p>Follow our build in public. Posts and product updates land here and on our socials.</p>
      </div>
      <div class="grid grid-3">
        {posts.map((p, i) => (
          <a class="post card reveal" data-delay={i % 3} href={p.href}>
            <div class="post-top"><span class="post-tag">{p.tag}</span><span class="post-date">{p.date}</span></div>
            <h3>{p.title}</h3>
            <p>{p.excerpt}</p>
            <span class="post-link">Read more <i class="fas fa-arrow-right"></i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Want to build with us?"
    text="We're a small team with big ambitions for Nigerian real estate. If that excites you, reach out."
    primaryLabel="Get in touch"
    primaryHref="mailto:careers@rentease9ja.com?subject=I%20want%20to%20join%20RentEase%209ja"
    secondaryLabel="Read our story"
    secondaryHref="/aboutus"
  />
</Base>

<style>
  .founders { gap: clamp(20px, 3vw, 32px); }
  .founder { display: flex; gap: 22px; align-items: flex-start; padding: 30px 28px; }
  .f-body h3 { margin-bottom: 2px; }
  .avatar { width: 96px; height: 96px; border-radius: 50%; flex-shrink: 0; object-fit: cover; box-shadow: var(--shadow-card); }
  .avatar--initials { display: grid; place-items: center; background: var(--brand-gradient); color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 1.8rem; letter-spacing: -.02em; }
  .avatar--initials.sm { width: 88px; height: 88px; font-size: 1.6rem; margin: 0 auto 16px; }
  .role { color: var(--brand-blue); font-weight: 700; font-size: .92rem; margin-bottom: 12px; }
  .bio { color: var(--text-muted); font-size: .95rem; line-height: 1.65; margin-bottom: 14px; }
  .f-socials { display: flex; gap: 10px; }
  .f-socials a { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-2); border: 1px solid var(--border); color: var(--brand-blue); transition: var(--transition); }
  .f-socials a:hover { background: var(--brand-gradient); color: #fff; border-color: transparent; transform: translateY(-2px); }

  .member { text-align: center; }
  .member h3 { font-size: 1.1rem; margin-bottom: 2px; }
  .member .role { margin-bottom: 0; }

  .post { padding: 28px 26px; display: flex; flex-direction: column; }
  .post-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
  .post-tag { background: var(--brand-gradient-soft); color: var(--brand-blue); font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; padding: 5px 11px; border-radius: var(--r-pill); }
  .post-date { color: var(--text-muted); font-size: .82rem; }
  .post h3 { font-size: 1.2rem; margin-bottom: 8px; }
  .post p { color: var(--text-muted); font-size: .95rem; margin-bottom: 16px; }
  .post-link { margin-top: auto; color: var(--brand-blue); font-weight: 700; font-size: .9rem; display: inline-flex; align-items: center; gap: 8px; transition: var(--transition); }
  .post:hover .post-link { gap: 12px; }

  @media (max-width: 560px) { .founder { flex-direction: column; align-items: center; text-align: center; } .f-socials { justify-content: center; } }
</style>
