---
import Base from '../layouts/Base.astro';

const features = [
  { icon: 'fa-id-card', title: 'Identity checks', text: 'Agent and landlord accounts complete KYC checks before they can use protected transaction workflows.' },
  { icon: 'fa-shield-halved', title: 'Protected payments', text: 'The payment flow records agreed release conditions and produces a digital transaction history.' },
  { icon: 'fa-file-signature', title: 'Digital contracts', text: 'Sign legally binding tenancy agreements from your phone. Documents remain securely available for the applicable retention period.' },
];

const roles = [
  { icon: 'fa-house-user', title: 'For tenants', text: 'Search, communicate, and keep the rental process in one record.', perks: ['Review listing status', 'Use protected payment steps', 'Sign documents digitally', 'Log maintenance requests'] },
  { icon: 'fa-key', title: 'For landlords', text: 'Automate your portfolio, track payments, and manage properties.', perks: ['Automated rent reminders', 'Screened & verified tenants', 'Dashboard for property metrics', 'Direct payouts to your bank'] },
  { icon: 'fa-briefcase', title: 'For agents', text: 'Close deals faster and build a verifiable digital reputation.', perks: ['Built-in CRM for leads', 'Verified blue badge', 'Digital scheduling & viewings', 'Secure commission payouts'] },
];
---
<Base
  title="Join the RentEase 9ja Waitlist | Early Access"
  description="Join 800+ Nigerians on the RentEase 9ja waitlist. Get early access to a safer digital property platform with verified listings, protected payments, and digital leases."
  active="/waitlist"
>
  <section class="wl-hero">
    <div class="container wl-grid">
      <div class="wl-copy reveal">
        <span class="eyebrow">Early access</span>
        <h1>Join early access for clearer property transactions.</h1>
        <p>Get product updates and priority onboarding for RentEase 9ja across tenant, agent, and landlord accounts.</p>
        <ul class="wl-badges">
          <li><i class="fas fa-circle-check"></i> Verified listings</li>
          <li><i class="fas fa-lock"></i> Escrow payments</li>
          <li><i class="fas fa-file-signature"></i> Digital leases</li>
        </ul>
      </div>

      <div class="form-card reveal" id="waitlist-form-card" data-delay="1">
        <form id="form-content" novalidate>
          <h3>Register your interest</h3>
          <div class="error-banner" id="error-banner" role="alert" aria-live="polite"></div>

          <div class="form-row">
            <div class="form-group">
              <label for="fname">First name</label>
              <input type="text" id="fname" name="fname" placeholder="e.g. Chuka" autocomplete="given-name" required aria-describedby="error-banner" />
            </div>
            <div class="form-group">
              <label for="lname">Last name</label>
              <input type="text" id="lname" name="lname" placeholder="e.g. Obi" autocomplete="family-name" />
            </div>
          </div>

          <div class="form-group">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" placeholder="chuka@example.com" autocomplete="email" required aria-describedby="error-banner" />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="phone">Phone number <span class="optional">(optional)</span></label>
              <input type="tel" id="phone" name="phone" placeholder="0800 000 0000" autocomplete="tel" inputmode="tel" />
            </div>
            <div class="form-group">
              <label for="role">I am a...</label>
              <select id="role" name="role" required aria-describedby="error-banner">
                <option value="" disabled selected>Select account type</option>
                <option value="Tenant">Tenant</option>
                <option value="Landlord">Landlord</option>
                <option value="Agent">Agent / Realtor</option>
              </select>
            </div>
          </div>

          <button class="submit-btn" id="submit-btn" type="submit">
            <span class="btn-text">Join the waitlist</span>
            <span class="btn-spinner" aria-hidden="true"></span>
          </button>
          <p class="form-note"><span>800+</span> early-access registrations. Product updates only.</p>
        </form>

        <div class="success-state" id="success-state" role="status" aria-live="polite" tabindex="-1">
          <span class="success-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.8 10A10 10 0 1 1 17 3.3"/><path d="m9 11 3 3L22 4"/></svg></span>
          <div class="success-title">You're in, <span class="success-name" id="success-name"></span>!</div>
          <p class="success-sub">Your early-access registration is recorded.<br /><strong>Check your inbox for confirmation.</strong></p>
          <div class="success-email-box">
            <div class="seb-label">Confirmation sent to</div>
            <div class="seb-val" id="success-email-display"></div>
          </div>
          <div class="success-tags">
            <span class="stag"><i class="fas fa-bolt"></i> Early access</span>
            <span class="stag"><i class="fas fa-ticket"></i> Spot reserved</span>
          </div>
          <a class="share-btn" id="whatsapp-share" href="#" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> Share via WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Transaction controls</span>
        <h2>A record for the important steps</h2>
        <p>Identity, payment, and document workflows are designed to give each party clearer evidence.</p>
      </div>
      <div class="grid grid-3">
        {features.map((f, i) => (
          <div class="feature card reveal" data-delay={i % 3}>
            <div class="f-icon"><i class={`fas ${f.icon}`}></i></div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Built for the ecosystem</span>
        <h2>A dashboard tailored to your role</h2>
      </div>
      <div class="grid grid-3">
        {roles.map((r, i) => (
          <div class="role card reveal" data-delay={i % 3}>
            <div class="r-icon"><i class={`fas ${r.icon}`}></i></div>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
            <ul>{r.perks.map((p) => (<li><i class="fas fa-circle-check"></i> {p}</li>))}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="referral reveal">
        <div class="ref-icon"><i class="fas fa-people-group"></i></div>
        <div class="ref-body">
          <span class="eyebrow">Early access</span>
          <h2>Join early and bring your community</h2>
          <p>Reserve your place on the waitlist, then share RentEase 9ja with people who want a safer, simpler way to rent, buy, or manage property.</p>
        </div>
        <a href="#waitlist-form-card" class="btn btn-primary ref-cta" data-focus-waitlist>Join the waitlist <i class="fas fa-arrow-right"></i></a>
      </div>
    </div>
  </section>

  <section class="wl-bottom">
    <div class="container reveal">
      <h2>Stay informed about early access</h2>
      <p>Join now for launch updates and priority onboarding when early access opens.</p>
      <a href="#waitlist-form-card" class="btn btn-light" data-focus-waitlist>Join the waitlist</a>
    </div>
  </section>
</Base>

<style>
  .wl-hero { position: relative; overflow: hidden; background: var(--navy-900); color: var(--on-dark); padding-block: clamp(56px, 8vw, 88px); }
  .wl-grid { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(30px, 5vw, 64px); align-items: center; }
  .wl-copy h1 { color: #fff; margin: 18px 0 16px; }
  .wl-copy > p { color: var(--on-dark-2); font-size: 1.12rem; max-width: 480px; }
  .wl-badges { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 26px; }
  .wl-badges li { color: var(--on-dark); font-weight: 600; font-size: .92rem; }
  .wl-badges i { color: var(--brand-green); margin-right: 6px; }

  .form-card { background: var(--surface); border-radius: var(--r-xl); padding: clamp(28px, 4vw, 44px); box-shadow: 0 14px 32px rgba(0,0,0,.18); }
  .form-card h3 { font-size: 1.4rem; margin-bottom: 22px; }
  .form-row { display: flex; gap: 16px; }
  .form-row .form-group { flex: 1; }
  .form-group { margin-bottom: 16px; text-align: left; }
  label { display: block; font-size: .82rem; font-weight: 600; color: var(--text-2); margin-bottom: 7px; }
  .optional { color: var(--text-muted); font-weight: 500; }
  input, select { width: 100%; padding: 13px 15px; border: 1px solid var(--border); border-radius: var(--r-md); font: inherit; font-size: .95rem; background: var(--surface-2); color: var(--text); outline: none; transition: var(--transition); appearance: none; }
  select { background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236F7785' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e"); background-repeat: no-repeat; background-position: right 14px center; background-size: 16px; padding-right: 38px; }
  input:focus, select:focus { border-color: var(--brand-blue); background: #fff; box-shadow: 0 0 0 4px rgba(30,78,140,.12); }
  input::placeholder { color: var(--text-muted); }
  input.error, select.error { border-color: var(--danger); background: #FEF2F2; }

  .error-banner { display: none; background: #FEF2F2; border-left: 4px solid var(--danger); color: #B91C1C; font-size: .88rem; padding: 11px 14px; border-radius: var(--r-sm); margin-bottom: 16px; }
  .error-banner.show { display: block; }

  .submit-btn { width: 100%; margin-top: 6px; background: var(--brand-blue); color: #fff; font-family: var(--font-body); font-weight: 700; font-size: 1rem; padding: 15px; border-radius: var(--r-md); box-shadow: var(--shadow-sm); transition: var(--transition); display: inline-flex; align-items: center; justify-content: center; gap: 10px; }
  .submit-btn:hover { background: #173F74; }
  .submit-btn:disabled { opacity: .75; cursor: not-allowed; transform: none; }
  .btn-spinner { display: none; width: 18px; height: 18px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
  .submit-btn.loading .btn-text { display: none; }
  .submit-btn.loading .btn-spinner { display: inline-block; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .form-note { text-align: center; color: var(--text-muted); font-size: .82rem; margin-top: 14px; }
  .form-note span { color: var(--brand-green); font-weight: 700; }

  .success-state { display: none; text-align: center; padding: 10px 0; }
  .success-icon { display: inline-flex; color: var(--brand-green); }
  .success-icon svg { width: 54px; height: 54px; }
  .success-title { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; color: var(--text); margin: 12px 0 8px; }
  .success-name { color: var(--brand-green); }
  .success-sub { color: var(--text-muted); margin-bottom: 18px; }
  .success-email-box { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--r-md); padding: 14px; margin-bottom: 16px; }
  .seb-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); }
  .seb-val { font-weight: 700; color: var(--text); margin-top: 4px; }
  .success-tags { display: flex; gap: 10px; justify-content: center; margin-bottom: 18px; }
  .stag { background: var(--brand-gradient-soft); color: var(--brand-blue); font-size: .8rem; font-weight: 700; padding: 6px 12px; border-radius: var(--r-pill); }
  .share-btn { display: inline-flex; align-items: center; gap: 8px; background: #16813E; color: #fff; font-weight: 700; padding: 12px 22px; border-radius: var(--r-md); transition: var(--transition); }
  .share-btn:hover { background: #116932; }

  .feature { padding: 30px 28px; }
  .f-icon { width: 42px; height: 42px; border-radius: 4px; display: grid; place-items: center; font-size: 1rem; color: #fff; background: var(--brand-blue); margin-bottom: 18px; }
  .feature h3 { margin-bottom: 8px; }
  .feature p { color: var(--text-muted); }

  .role { padding: 30px 28px; }
  .r-icon { width: 42px; height: 42px; border-radius: 4px; display: grid; place-items: center; font-size: 1rem; color: var(--brand-blue); background: var(--brand-gradient-soft); margin-bottom: 16px; }
  .role h3 { margin-bottom: 8px; }
  .role > p { color: var(--text-muted); margin-bottom: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--border); }
  .role ul { display: flex; flex-direction: column; gap: 10px; }
  .role li { color: var(--text-2); font-size: .95rem; }
  .role li i { color: var(--brand-green); margin-right: 8px; }

  .referral { display: flex; align-items: center; gap: 28px; background: var(--brand-gradient-soft); border: 1px solid var(--border); border-radius: var(--r-xl); padding: clamp(28px, 4vw, 44px); }
  .ref-icon { flex-shrink: 0; width: 46px; height: 46px; border-radius: 4px; display: grid; place-items: center; font-size: 1rem; color: #fff; background: var(--brand-blue); }
  .ref-body { flex: 1; }
  .ref-body h2 { font-size: 1.9rem; margin: 10px 0 8px; }
  .ref-body p { color: var(--text-2); max-width: 640px; }
  .ref-cta { flex-shrink: 0; }
  @media (max-width: 760px) { .referral { flex-direction: column; text-align: center; align-items: center; } .ref-body p { margin-inline: auto; } }

  .wl-bottom { background: var(--brand-blue); color: #fff; text-align: center; padding-block: clamp(56px, 8vw, 84px); }
  .wl-bottom h2 { color: #fff; }
  .wl-bottom p { color: rgba(255,255,255,.92); max-width: 600px; margin: 14px auto 28px; font-size: 1.08rem; }

  @media (max-width: 900px) { .wl-grid { grid-template-columns: 1fr; } .wl-copy { text-align: center; } .wl-copy > p { margin-inline: auto; } .wl-badges { justify-content: center; } }
  @media (max-width: 520px) { .form-row { flex-direction: column; gap: 0; } .ref-body h2 { font-size: 1.6rem; } }
</style>

<script>
  // @ts-nocheck
  import { API_BASE } from '../config';

  const API_URL = API_BASE + '/v1/waitlist';

  const showError = (msg) => {
    const banner = document.getElementById('error-banner');
    banner.textContent = msg;
    banner.classList.add('show');
    setTimeout(() => banner.classList.remove('show'), 6000);
  };
  const clearErrors = () => {
    ['fname', 'lname', 'email', 'phone', 'role'].forEach((id) => document.getElementById(id)?.classList.remove('error'));
    document.getElementById('error-banner').classList.remove('show');
  };
  const markError = (id, msg) => {
    const el = document.getElementById(id);
    if (el) { el.classList.add('error'); el.focus(); }
    showError(msg);
  };
  const validateForm = () => {
    clearErrors();
    const fields = {
      fname: document.getElementById('fname').value.trim(),
      email: document.getElementById('email').value.trim(),
      role: document.getElementById('role').value,
    };
    if (!fields.fname) { markError('fname', 'First name is required.'); return false; }
    if (!fields.email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(fields.email)) { markError('email', 'Please provide a valid email address.'); return false; }
    if (!fields.role) { markError('role', 'Please select your account type.'); return false; }
    return true;
  };
  async function handleSubmit() {
    if (!validateForm()) return;
    const payload = {
      fname: document.getElementById('fname').value.trim(),
      lname: document.getElementById('lname').value.trim() || undefined,
      email: document.getElementById('email').value.trim(),
      phone: document.getElementById('phone').value.trim() || undefined,
      role: document.getElementById('role').value,
    };
    const btn = document.getElementById('submit-btn');
    btn.disabled = true; btn.classList.add('loading');
    try {
      const res = await fetch(API_URL, { method: 'POST', headers: { 'Content-Type': 'application/json', 'ngrok-skip-browser-warning': 'true' }, body: JSON.stringify(payload) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (res.status === 409) showError('You are already on the waitlist! Check your inbox for details.');
        else showError(data.message || 'Unable to process your request. Please try again.');
        return;
      }
      document.getElementById('form-content').style.display = 'none';
      document.getElementById('success-state').style.display = 'block';
      document.getElementById('success-state').focus();
      document.getElementById('success-name').textContent = payload.fname;
      document.getElementById('success-email-display').textContent = payload.email;
      const shareText = encodeURIComponent(`I joined the RentEase 9ja early-access waitlist. It is a digital property platform for safer renting, buying, and property management in Nigeria.\n\nJoin here: https://rentease9ja.com/waitlist`);
      document.getElementById('whatsapp-share').href = `https://wa.me/?text=${shareText}`;
    } catch (err) {
      showError('Network error. Please check your connection and try again.');
      console.error('Waitlist Submission Error:', err);
    } finally {
      btn.disabled = false; btn.classList.remove('loading');
    }
  }
  document.getElementById('form-content')?.addEventListener('submit', (event) => {
    event.preventDefault();
    handleSubmit();
  });
  document.querySelectorAll('[data-focus-waitlist]').forEach((link) => {
    link.addEventListener('click', () => setTimeout(() => document.getElementById('fname')?.focus(), 0));
  });
</script>
