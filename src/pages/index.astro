---
import Base from '../layouts/Base.astro';
import ListingCard from '../components/ListingCard.astro';
import HeroPhones from '../components/HeroPhones.astro';
import DeviceLaptop from '../components/DeviceLaptop.astro';

const stats = [
  { value: '800+', label: 'Early-access registrations' },
  { value: 'KYC', label: 'Participant identity checks' },
  { value: 'Escrow', label: 'Protected payment flow' },
  { value: 'Digital', label: 'Agreements and receipts' },
];

const steps = [
  { icon: 'fa-magnifying-glass', title: 'Review the property record', text: 'See listing information, available verification details, and the person responsible for the property.' },
  { icon: 'fa-comments', title: 'Keep the conversation together', text: 'Message, schedule a viewing, and record offers in the same transaction thread.' },
  { icon: 'fa-shield-halved', title: 'Document payment and handover', text: 'Use the protected payment flow, digital agreements, and receipts to keep both sides accountable.' },
];

const audiences = [
  { icon: 'fa-house-user', title: 'Renters and buyers', text: 'Review properties, communicate, and keep a record of each step.', perks: ['Property and participant checks', 'In-app chat and viewings', 'Protected payment flow', 'Digital agreements'], href: '/rent', cta: 'Explore the preview' },
  { icon: 'fa-building-user', title: 'Landlords and agents', text: 'Manage listings, enquiries, viewings, and tenancy records.', perks: ['Listing management', 'Lead and offer tracking', 'Unit and tenant records', 'Digital rent collection'], href: '/waitlist', cta: 'Join early access' },
  { icon: 'fa-helmet-safety', title: 'Property developers', text: 'Present estates and plots with documents and structured buyer workflows.', perks: ['Estate inventory', 'Document records', 'Buyer demand reporting', 'Sales support'], href: '/for-developers', cta: 'Discuss a partnership' },
];

const listings = [
  { image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=900', price: '₦1,200,000 / yr', title: 'Modern 2-Bedroom Flat', location: 'Lekki, Lagos', kind: 'rent', meta: [{ icon: 'fa-bed', label: '2 beds' }, { icon: 'fa-bath', label: '2 baths' }] },
  { image: 'https://images.unsplash.com/photo-1570129477492-45c003edd2be?q=80&w=900', price: '₦45,000,000', title: 'Modern 4-Bedroom Duplex', location: 'Maitama, Abuja', kind: 'buy', meta: [{ icon: 'fa-bed', label: '4 beds' }, { icon: 'fa-ruler-combined', label: '450 sqm' }] },
  { image: 'https://images.unsplash.com/photo-1592595896551-12b371d546d5?q=80&w=900', price: '₦8,500,000', title: '600sqm Residential Plot', location: 'Ibeju-Lekki, Lagos', kind: 'land', meta: [{ icon: 'fa-ruler-combined', label: '600 sqm' }, { icon: 'fa-file-contract', label: 'C of O' }] },
];

const appFeatures = [
  { icon: 'fa-circle-check', text: 'Verified listings & agents' },
  { icon: 'fa-comments', text: 'In-app chat, calls & viewings' },
  { icon: 'fa-wallet', text: 'Secure wallet & rent payments' },
  { icon: 'fa-file-signature', text: 'Digital tenancy agreements' },
  { icon: 'fa-bell', text: 'Rent reminders & receipts' },
  { icon: 'fa-headset', text: 'In-app support' },
];

const transactionControls = [
  { number: '01', title: 'Know who you are dealing with', text: 'Identity checks help connect each agent, landlord, and applicant to a platform account.' },
  { number: '02', title: 'Keep the transaction record', text: 'Messages, viewing details, offers, agreements, and receipts stay attached to the property journey.' },
  { number: '03', title: 'Use defined payment terms', text: 'Protected payment and handover steps make the expected release conditions visible to both sides.' },
];

const faqs = [
  { q: 'What is RentEase 9ja?', a: 'RentEase 9ja is a property platform for Nigeria where you can rent, buy, and sell verified homes and land, with in-app chat, secure payments, and digital agreements that protect everyone.' },
  { q: 'How do you verify listings?', a: 'Every listing goes through checks on ownership and documents before it goes live, and agents are identity-verified, so you only deal with real people and real properties.' },
  { q: 'Is it safe to pay rent through the app?', a: 'Yes. Payments run through a secure, escrow-style flow with digital receipts and agreements, so funds and terms are protected on both sides.' },
  { q: 'How much does it cost to list a property?', a: 'Creating a verified listing is free for landlords and agents during launch. Premium tools for high-volume agents and developers are available.' },
  { q: 'When is the app launching?', a: 'We are onboarding early users now. Join the waitlist to get first access and launch updates.' },
];

// FAQ rich-result structured data (eligible for Google FAQ rich results).
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base active="/">
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow reveal">Early access for Nigeria</span>
        <h1 class="reveal" data-delay="1">Rent, buy, and manage property in Nigeria.</h1>
        <p class="reveal" data-delay="2">RentEase 9ja brings participant checks, property records, protected payment flows, and digital agreements into one transaction workspace.</p>
        <div class="hero-cta reveal" data-delay="3">
          <a href="/waitlist" class="btn btn-primary">Join the waitlist <i class="fas fa-arrow-right"></i></a>
          <a href="/rent" class="btn btn-ghost">Explore listings</a>
        </div>
        <div class="hero-proof reveal" data-delay="3">
          <strong>800+</strong><span>early-access registrations</span>
        </div>
        <ul class="hero-trust reveal" data-delay="4">
          <li><i class="fas fa-circle-check"></i> Listing review</li>
          <li><i class="fas fa-lock"></i> Payment records</li>
          <li><i class="fas fa-user-shield"></i> Identity checks</li>
        </ul>
      </div>
      <div class="hero-media reveal" data-delay="2">
        <HeroPhones />
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="section section--surface stats-sec">
    <div class="container grid grid-4">
      {stats.map((s, i) => (
        <div class="stat reveal" data-delay={i}>
          <div class="stat-val">{s.value}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- PROBLEM → SOLUTION -->
  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Why RentEase</span>
        <h2>A clearer process for every property transaction</h2>
        <p>Property deals often move across calls, cash payments, and disconnected documents. RentEase 9ja gives each step a visible record.</p>
      </div>
      <div class="grid grid-2 ps-grid">
        <div class="ps-card pain reveal">
          <h3><i class="fas fa-triangle-exclamation"></i> Without a transaction record</h3>
          <ul>
            <li>Fake photos & listings that don't exist</li>
            <li>Agents you can't verify or trust</li>
            <li>Cash payments with no receipts or protection</li>
            <li>No agreements, disputes with no proof</li>
            <li>Endless calls, no real information</li>
          </ul>
        </div>
        <div class="ps-card gain reveal" data-delay="1">
          <h3><i class="fas fa-circle-check"></i> With RentEase 9ja</h3>
          <ul>
            <li>Every listing checked for real docs & owners</li>
            <li>Identity-verified agents and landlords</li>
            <li>Secure, escrow-style payments with receipts</li>
            <li>Digital tenancy agreements that protect both sides</li>
            <li>In-app chat, viewings & offers in one place</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">How it works</span>
        <h2>From search to keys in three steps</h2>
      </div>
      <div class="grid grid-3">
        {steps.map((s, i) => (
          <div class="step reveal" data-delay={i}>
            <span class="step-num">{i + 1}</span>
            <div class="step-icon"><i class={`fas ${s.icon}`}></i></div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AUDIENCES -->
  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Who it serves</span>
        <h2>One record across every side of the transaction</h2>
      </div>
      <div class="grid grid-3">
        {audiences.map((a, i) => (
          <div class="aud card reveal" data-delay={i}>
            <div class="aud-icon"><i class={`fas ${a.icon}`}></i></div>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
            <ul>
              {a.perks.map((p) => (<li><i class="fas fa-check"></i> {p}</li>))}
            </ul>
            <a href={a.href} class="aud-link">{a.cta} <i class="fas fa-arrow-right"></i></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED LISTINGS -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Marketplace preview</span>
        <h2>Example listing experience</h2>
        <p>Illustrative inventory shown for product preview. Live availability and verification status will appear in the app.</p>
      </div>
      <div class="grid grid-3">
        {listings.map((l, i) => (
          <div class="reveal" data-delay={i}><ListingCard {...l} verified={false} /></div>
        ))}
      </div>
      <div class="center-cta reveal"><a href="/rent" class="btn btn-ghost">Browse all listings <i class="fas fa-arrow-right"></i></a></div>
    </div>
  </section>

  <!-- WEB WORKSPACE SHOWCASE -->
  <section class="section section--dark app-sec">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">For agents &amp; landlords</span>
        <h2>Run your whole agency from the <span class="gradient-text">web</span></h2>
        <p>Agents and landlords get a full desktop workspace, listings, leads, applications, viewings, payouts and registry, all in one dashboard.</p>
      </div>
      <div class="web-shot reveal" data-delay="1">
        <DeviceLaptop />
      </div>
      <ul class="app-chips reveal" data-delay="2">
        {appFeatures.map((f) => (<li><i class={`fas ${f.icon}`}></i> {f.text}</li>))}
      </ul>
      <div class="web-cta reveal" data-delay="2">
        <a href="/download" class="btn btn-light">Download desktop app</a>
        <a href="/waitlist" class="btn btn-on-dark">Join the waitlist</a>
      </div>
      <p class="web-os reveal" data-delay="2"><i class="fab fa-apple"></i> macOS &nbsp;·&nbsp; <i class="fab fa-windows"></i> Windows &nbsp;·&nbsp; <i class="fab fa-linux"></i> Linux</p>
    </div>
  </section>

  <!-- TRACTION / INVESTORS -->
  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Platform scope</span>
        <h2>Designed for a fragmented property market</h2>
        <p>RentEase 9ja connects the people, records, payments, and agreements that currently sit across separate channels.</p>
      </div>
      <div class="grid grid-4 invest-stats">
        <div class="i-stat reveal"><div class="i-val">800+</div><div class="i-label">Early-access registrations</div></div>
        <div class="i-stat reveal" data-delay="1"><div class="i-val">3</div><div class="i-label">Client platforms</div></div>
        <div class="i-stat reveal" data-delay="2"><div class="i-val">4</div><div class="i-label">Property roles supported</div></div>
        <div class="i-stat reveal" data-delay="3"><div class="i-val">1</div><div class="i-label">Shared transaction record</div></div>
      </div>
      <div class="invest-cta reveal">
        <a href="/investor-access" class="btn btn-primary">Request investor deck</a>
        <a href="/aboutus" class="btn btn-ghost">Read our story</a>
      </div>
    </div>
  </section>

  <!-- TRANSACTION CONTROLS -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Transaction controls</span>
        <h2>Trust built from visible records</h2>
      </div>
      <div class="grid grid-3">
        {transactionControls.map((item, i) => (
          <article class="control reveal" data-delay={i}>
            <span>{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--mist">
    <div class="container faq-wrap">
      <div class="section-head reveal">
        <span class="eyebrow">FAQ</span>
        <h2>Questions, answered</h2>
      </div>
      <div class="faq reveal">
        {faqs.map((f) => (
          <details>
            <summary>{f.q} <i class="fas fa-plus"></i></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </section>

  <!-- TRUST & SECURITY -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Safety by design</span>
        <h2>Built to protect every naira and every deal</h2>
      </div>
      <div class="grid grid-4 trust-band">
        <div class="tb-item reveal"><span class="tb-ic"><i class="fas fa-shield-halved"></i></span><h3>Escrow-secured</h3><p>Rent &amp; fees are held safely and released only on a clean handover.</p></div>
        <div class="tb-item reveal" data-delay="1"><span class="tb-ic"><i class="fas fa-id-card"></i></span><h3>Identity verified</h3><p>Every agent and landlord passes strict KYC verification.</p></div>
        <div class="tb-item reveal" data-delay="2"><span class="tb-ic"><i class="fas fa-lock"></i></span><h3>Protected data</h3><p>Data is encrypted in transit and protected by access controls and secure infrastructure.</p></div>
        <div class="tb-item reveal" data-delay="3"><span class="tb-ic"><i class="fas fa-file-shield"></i></span><h3>NDPA-aligned</h3><p>Personal data is handled to Nigerian data-protection standards.</p></div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <div class="container final-inner reveal">
      <h2>Get early access to RentEase 9ja.</h2>
      <p>Join the waitlist for product updates and onboarding.</p>
      <div class="final-actions">
        <a href="/waitlist" class="btn btn-light">Join the waitlist <i class="fas fa-arrow-right"></i></a>
        <a href="/how-it-works" class="btn btn-on-dark">See how it works</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; background: var(--bg); padding-block: clamp(48px, 6vw, 72px); border-bottom: 1px solid var(--border); }
  .hero-inner { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: clamp(30px, 5vw, 70px); }
  .hero-copy h1 { margin: 18px 0 16px; font-size: 2.75rem; max-width: 650px; }
  .hero-copy > p { font-size: 1.05rem; color: var(--text-2); max-width: 500px; }
  .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin: 24px 0 16px; }
  .hero-proof { display: flex; align-items: baseline; gap: 8px; margin-bottom: 18px; color: var(--text-muted); font-size: .9rem; }
  .hero-proof strong { color: var(--text); font-size: 1.35rem; }
  .hero-trust { display: flex; align-items: center; gap: 18px; flex-wrap: nowrap; color: var(--text-2); font-weight: 600; font-size: .86rem; }
  .hero-trust li { display: inline-flex; align-items: center; white-space: nowrap; }
  .hero-trust i { color: var(--brand-green); margin-right: 6px; }
  .hero-media { display: flex; justify-content: center; align-items: center; padding-block: 14px; }
  @media (max-width: 920px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-copy > p { margin-inline: auto; }
    .hero-cta, .hero-trust { justify-content: center; }
    .hero-trust { flex-wrap: wrap; row-gap: 8px; }
    .hero-media { margin-top: 6px; padding-block: 8px 0; }
  }
  @media (max-width: 720px) {
    .hero-copy h1 { font-size: 2.15rem; }
    .hero-inner { gap: 22px; }
    .hero-trust { display: none; }
    .hero-media { max-height: 110px; overflow: hidden; align-items: flex-start; }
    .hero-proof { justify-content: center; margin-bottom: 0; }
  }

  /* STATS */
  .stats-sec { padding-block: clamp(40px, 5vw, 64px); }
  .stat { text-align: left; border-top: 2px solid var(--brand-blue); padding-top: 18px; }
  .stat-val { font-family: var(--font-display); font-weight: 700; font-size: 1.7rem; letter-spacing: 0; color: var(--text); }
  .stat-label { color: var(--text-muted); font-weight: 600; margin-top: 6px; font-size: .95rem; }

  /* TRUST & SECURITY band */
  .trust-band { gap: clamp(16px, 2.4vw, 28px); }
  .tb-item { text-align: left; padding: 8px 0; border-top: 1px solid var(--border); }
  .tb-ic { width: 36px; height: 36px; border-radius: 4px; display: grid; place-items: center; margin: 16px 0; font-size: 1rem; color: var(--brand-blue); background: var(--brand-gradient-soft); }
  .tb-item h3 { margin-bottom: 8px; font-size: 1.05rem; }
  .tb-item p { color: var(--text-muted); font-size: .92rem; line-height: 1.6; }

  /* PROBLEM/SOLUTION */
  .ps-card { padding: 32px; border-radius: var(--r-lg); border: 1px solid var(--border); }
  .ps-card h3 { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
  .ps-card ul { display: flex; flex-direction: column; gap: 12px; }
  .ps-card li { position: relative; padding-left: 4px; color: var(--text-2); }
  .ps-card.pain { background: #fff; }
  .ps-card.pain h3 i { color: var(--danger); }
  .ps-card.pain li { opacity: .85; }
  .ps-card.gain { background: var(--surface); border-top: 3px solid var(--brand-green); }
  .ps-card.gain h3 i { color: var(--brand-green); }
  .ps-card.gain li { font-weight: 500; color: var(--text); }

  /* STEPS */
  .step { position: relative; background: var(--surface); border-top: 2px solid var(--brand-blue); padding: 30px 24px; }
  .step-num { position: absolute; top: 22px; right: 26px; font-family: var(--font-display); font-weight: 800; font-size: 2rem; color: var(--border); line-height: 1; }
  .step-icon { width: 42px; height: 42px; border-radius: 4px; display: grid; place-items: center; font-size: 1rem; color: #fff; background: var(--brand-blue); margin-bottom: 20px; }
  .step h3 { margin-bottom: 10px; }
  .step p { color: var(--text-muted); }

  /* AUDIENCES */
  .aud { padding: 32px 28px; display: flex; flex-direction: column; }
  .aud-icon { width: 40px; height: 40px; border-radius: 4px; display: grid; place-items: center; font-size: 1rem; color: var(--brand-blue); background: var(--brand-gradient-soft); margin-bottom: 18px; }
  .aud h3 { margin-bottom: 8px; }
  .aud > p { color: var(--text-muted); margin-bottom: 18px; }
  .aud ul { display: flex; flex-direction: column; gap: 10px; margin-bottom: 22px; }
  .aud li { color: var(--text-2); font-size: .95rem; }
  .aud li i { color: var(--brand-green); margin-right: 8px; }
  .aud-link { margin-top: auto; font-weight: 700; color: var(--brand-blue); display: inline-flex; align-items: center; gap: 8px; transition: var(--transition); }
  .aud-link:hover { gap: 12px; }

  .center-cta { text-align: center; margin-top: 44px; }

  /* WEB WORKSPACE SHOWCASE */
  .web-shot { position: relative; z-index: 1; }
  .app-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 14px; max-width: 760px; margin: 30px auto 0; }
  .app-chips li { display: inline-flex; align-items: center; gap: 8px; color: var(--on-dark); font-weight: 500; font-size: .9rem; border-bottom: 1px solid rgba(255,255,255,.2); padding: 8px 4px; }
  .app-chips i { color: #8FE3B9; }
  .web-cta { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin-top: 28px; }
  .web-os { text-align: center; margin-top: 14px; color: var(--on-dark-2); font-size: .9rem; font-weight: 600; }
  .web-os i { color: #fff; }
  @media (max-width: 600px) { .app-chips li { font-size: .82rem; padding: 7px 12px; } }

  /* INVESTORS */
  .invest-stats { margin-bottom: 40px; }
  .i-stat { text-align: left; border-top: 2px solid var(--brand-blue); padding: 22px 0; }
  .i-val { font-family: var(--font-display); font-weight: 700; font-size: 1.75rem; letter-spacing: 0; color: var(--text); }
  .i-label { color: var(--text-muted); font-size: .9rem; margin-top: 6px; }
  .invest-cta { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  /* TRANSACTION CONTROLS */
  .control { border-top: 2px solid var(--brand-blue); padding: 24px 0; }
  .control > span { display: block; color: var(--brand-green-dark); font-size: .78rem; font-weight: 700; margin-bottom: 18px; }
  .control h3 { margin-bottom: 10px; }
  .control p { color: var(--text-muted); line-height: 1.65; }

  /* FAQ */
  .faq-wrap { max-width: 820px; }
  .faq details { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); padding: 4px 22px; margin-bottom: 12px; box-shadow: var(--shadow-sm); }
  .faq summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; cursor: pointer; list-style: none; padding: 18px 0; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: var(--text); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary i { color: var(--brand-blue); transition: var(--transition); flex-shrink: 0; }
  .faq details[open] summary i { transform: rotate(45deg); }
  .faq details p { color: var(--text-muted); padding: 0 0 20px; line-height: 1.7; }

  /* FINAL CTA */
  .final-cta { background: var(--brand-blue); color: #fff; padding-block: clamp(56px, 8vw, 88px); text-align: center; }
  .final-inner h2 { color: #fff; }
  .final-inner p { color: rgba(255,255,255,.9); font-size: 1.12rem; margin: 14px 0 28px; }
  .final-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
</style>
