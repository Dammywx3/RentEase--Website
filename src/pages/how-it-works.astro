---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import AppDemo from '../components/AppDemo.astro';
import CtaBand from '../components/CtaBand.astro';

const renterSteps = [
  { icon: 'fa-magnifying-glass', title: 'Search verified homes', text: 'Filter by city, budget, and type. Every listing is checked for real documents and real owners before it appears.' },
  { icon: 'fa-comments', title: 'Chat & book a viewing', text: 'Message identity-verified agents in-app, ask questions, and schedule a viewing, no endless phone calls.' },
  { icon: 'fa-file-signature', title: 'Sign a digital agreement', text: 'Review and sign a legally-sound tenancy agreement from your phone. A copy is stored securely for both sides.' },
  { icon: 'fa-shield-halved', title: 'Pay securely & move in', text: 'Pay rent and fees through a secure, escrow-style flow. Funds are protected and you get instant digital receipts.' },
];

const ownerSteps = [
  { icon: 'fa-id-card', title: 'Get verified', text: 'Complete a quick identity (KYC) check so seekers know you are real. Verified badges build instant trust.' },
  { icon: 'fa-house-circle-check', title: 'List your property', text: 'Add photos, details, and documents. The listing moves through review before it becomes available to seekers.' },
  { icon: 'fa-users', title: 'Get qualified leads', text: 'Receive enquiries and offers from serious, verified seekers. Chat, schedule viewings, and negotiate in-app.' },
  { icon: 'fa-wallet', title: 'Collect rent on time', text: 'Tenants pay through the platform with automated reminders, and payouts land directly in your bank account.' },
];

const trust = [
  { icon: 'fa-id-card', title: 'Identity verification', text: 'Agents, landlords, and developers complete KYC checks before they can transact.' },
  { icon: 'fa-file-contract', title: 'Document checks', text: 'Listings are reviewed for ownership and title documents before going live.' },
  { icon: 'fa-lock', title: 'Escrow-style payments', text: 'Funds are held securely and released on successful handover, no disappearing deposits.' },
  { icon: 'fa-scale-balanced', title: 'Digital agreements', text: 'Every deal is backed by a digital agreement and receipts, so there is always proof.' },
];
---
<Base
  title="How RentEase 9ja Works | Rent, Buy & List Safely"
  description="See how RentEase 9ja makes property safe in Nigeria, verified listings, in-app chat, digital agreements, and escrow-style payments for renters, landlords, and agents."
  active="/how-it-works"
>
  <PageHero
    eyebrow="How it works"
    title="Trust, built into <span class='gradient-text'>every step.</span>"
    subtitle="From your first search to signing and paying, RentEase 9ja removes the risk at each stage, for both sides of the deal."
  />

  <AppDemo />

  <section class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">For renters & buyers</span>
        <h2>Find and secure a home in 4 steps</h2>
      </div>
      <div class="flow">
        {renterSteps.map((s, i) => (
          <div class="flow-step reveal" data-delay={i % 4}>
            <div class="flow-icon"><i class={`fas ${s.icon}`}></i><span class="flow-num">{i + 1}</span></div>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">For landlords & agents</span>
        <h2>List and earn in 4 steps</h2>
      </div>
      <div class="flow">
        {ownerSteps.map((s, i) => (
          <div class="flow-step reveal" data-delay={i % 4}>
            <div class="flow-icon"><i class={`fas ${s.icon}`}></i><span class="flow-num">{i + 1}</span></div>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Why it's safe</span>
        <h2>The trust layer behind every deal</h2>
        <p>Four controls work together to reduce risk and preserve evidence.</p>
      </div>
      <div class="grid grid-4">
        {trust.map((t, i) => (
          <div class="trust-card reveal" data-delay={i % 4}>
            <div class="trust-icon"><i class={`fas ${t.icon}`}></i></div>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Get early access to the transaction workflow." text="Join the waitlist for product updates and onboarding." secondaryLabel="Talk to our team" secondaryHref="mailto:support@rentease9ja.com" />
</Base>

<style>
  .flow { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 18px; }
  .flow-step { display: flex; gap: 22px; align-items: flex-start; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 26px 28px; }
  .flow-icon { position: relative; flex-shrink: 0; width: 58px; height: 58px; border-radius: var(--r-md); display: grid; place-items: center; font-size: 1.35rem; color: #fff; background: var(--brand-gradient); }
  .flow-num { position: absolute; top: -8px; right: -8px; width: 24px; height: 24px; border-radius: 4px; background: #fff; color: var(--brand-blue); font-family: var(--font-display); font-weight: 800; font-size: .8rem; display: grid; place-items: center; border: 1px solid var(--border); }
  .flow-step h3 { margin-bottom: 6px; }
  .flow-step p { color: var(--text-muted); }

  .trust-card { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); border-radius: var(--r-lg); padding: 28px 24px; }
  .trust-icon { width: 40px; height: 40px; border-radius: 4px; display: grid; place-items: center; font-size: 1rem; color: #8FE3B9; background: rgba(43,182,115,.12); margin-bottom: 16px; }
  .trust-card h3 { color: #fff; margin-bottom: 8px; font-size: 1.15rem; }
  .trust-card p { color: var(--on-dark-2); font-size: .95rem; }
</style>
