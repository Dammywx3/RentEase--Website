---
import '../styles/global.css';
// Unified leads admin: one login (admin secret) → Waitlist, Contact,
// Partners and Investors in one dashboard. Standalone (no marketing chrome).
const API_BASE = import.meta.env.PUBLIC_API_BASE || 'https://api.rentease9ja.com';
---
<!doctype html>
<html lang="en" class="js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin · RentEase 9ja</title>
    <link rel="icon" href="/favicon.ico?v=3" sizes="16x16 32x32 48x48 64x64" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ API_BASE }}>window.__API_BASE__ = API_BASE;</script>
  </head>
  <body>
    <!-- LOGIN -->
    <div id="login" class="login-wrap">
      <form class="login-card" id="login-form">
        <div class="login-ico"><i class="fas fa-lock"></i></div>
        <h1>Admin access</h1>
        <p>Enter your admin secret to view captured leads.</p>
        <div class="a-error" id="login-error"></div>
        <input type="password" id="secret" placeholder="Admin secret" autocomplete="off" />
        <button type="submit" class="btn btn-primary" id="login-btn">Sign in <i class="fas fa-arrow-right"></i></button>
      </form>
    </div>

    <!-- DASHBOARD -->
    <div id="dash" hidden>
      <header class="a-top">
        <div class="a-brand"><img src="/logo.webp" alt="RentEase 9ja" /><span>Admin</span></div>
        <div class="a-top-actions">
          <button class="a-btn" id="refresh"><i class="fas fa-rotate-right"></i> Refresh</button>
          <button class="a-btn ghost" id="logout"><i class="fas fa-arrow-right-from-bracket"></i> Log out</button>
        </div>
      </header>

      <nav class="a-tabs" id="tabs"></nav>

      <div class="a-toolbar">
        <div class="a-search"><i class="fas fa-magnifying-glass"></i><input id="search" placeholder="Search…" /></div>
        <button class="a-btn ghost" id="export"><i class="fas fa-file-csv"></i> Export CSV</button>
      </div>

      <div class="a-state" id="state"></div>
      <div class="a-table-wrap"><table class="a-table" id="table"></table></div>
    </div>

    <style>
      :root { color-scheme: light; }
      body { background: var(--bg); color: var(--text); font-family: var(--font-body); margin: 0; }

      .login-wrap { min-height: 100vh; display: grid; place-items: center; padding: 24px; background: radial-gradient(120% 120% at 80% 0%, var(--mist), var(--bg)); }
      .login-card { width: 100%; max-width: 380px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-xl); padding: 36px 30px; box-shadow: var(--shadow-card); text-align: center; }
      .login-ico { width: 60px; height: 60px; border-radius: 50%; background: var(--brand-gradient); color: #fff; display: grid; place-items: center; font-size: 24px; margin: 0 auto 18px; }
      .login-card h1 { font-family: var(--font-display); font-size: 1.5rem; margin: 0 0 6px; }
      .login-card p { color: var(--text-muted); font-size: .95rem; margin: 0 0 20px; }
      .login-card input { width: 100%; padding: 13px 15px; border: 1px solid var(--border); border-radius: var(--r-md); font: inherit; background: var(--surface-2); margin-bottom: 14px; outline: none; }
      .login-card input:focus { border-color: var(--brand-blue); box-shadow: 0 0 0 4px rgba(30,78,140,.12); }
      .login-card .btn { width: 100%; justify-content: center; }
      .a-error { display: none; background: #FEF2F2; border-left: 4px solid var(--danger); color: #B91C1C; font-size: .88rem; padding: 10px 12px; border-radius: var(--r-sm); margin-bottom: 14px; text-align: left; }
      .a-error.show { display: block; }

      .a-top { display: flex; justify-content: space-between; align-items: center; padding: 14px clamp(16px, 4vw, 40px); background: var(--surface); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 10; }
      .a-brand { display: flex; align-items: center; gap: 10px; }
      .a-brand img { height: 34px; }
      .a-brand span { font-family: var(--font-display); font-weight: 800; color: var(--brand-blue); background: var(--brand-gradient-soft); padding: 3px 10px; border-radius: 999px; font-size: .8rem; }
      .a-top-actions { display: flex; gap: 10px; }
      .a-btn { background: var(--brand-gradient); color: #fff; border: none; font-weight: 700; font-size: .85rem; padding: 9px 16px; border-radius: var(--r-pill); cursor: pointer; display: inline-flex; gap: 7px; align-items: center; }
      .a-btn.ghost { background: var(--surface); color: var(--text-2); border: 1px solid var(--border); }

      .a-tabs { display: flex; gap: 8px; flex-wrap: wrap; padding: 16px clamp(16px, 4vw, 40px) 0; }
      .a-tab { background: var(--surface); border: 1px solid var(--border); color: var(--text-2); font-weight: 700; font-size: .9rem; padding: 9px 16px; border-radius: var(--r-pill); cursor: pointer; }
      .a-tab.active { background: var(--brand-gradient); color: #fff; border-color: transparent; }
      .a-tab .count { background: rgba(255,255,255,.25); border-radius: 999px; padding: 1px 8px; margin-left: 6px; font-size: .78rem; }
      .a-tab:not(.active) .count { background: var(--brand-gradient-soft); color: var(--brand-blue); }

      .a-toolbar { display: flex; gap: 12px; align-items: center; justify-content: space-between; padding: 16px clamp(16px, 4vw, 40px) 10px; flex-wrap: wrap; }
      .a-search { flex: 1; min-width: 200px; display: flex; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); padding: 9px 13px; color: var(--text-muted); }
      .a-search input { border: none; background: none; outline: none; font: inherit; flex: 1; color: var(--text); }

      .a-state { padding: 10px clamp(16px, 4vw, 40px); color: var(--text-muted); font-size: .9rem; }
      .a-table-wrap { overflow-x: auto; padding: 0 clamp(16px, 4vw, 40px) 60px; }
      .a-table { width: 100%; border-collapse: collapse; font-size: .88rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; }
      .a-table th { text-align: left; background: var(--surface-2); color: var(--text-2); font-size: .74rem; text-transform: uppercase; letter-spacing: .04em; padding: 11px 14px; border-bottom: 1px solid var(--border); white-space: nowrap; }
      .a-table td { padding: 11px 14px; border-bottom: 1px solid var(--border); color: var(--text-2); vertical-align: top; }
      .a-table tr:last-child td { border-bottom: none; }
      .a-table td.msg { max-width: 320px; white-space: pre-wrap; }
      .a-pill { font-size: .72rem; font-weight: 700; padding: 3px 9px; border-radius: 999px; background: var(--brand-gradient-soft); color: var(--brand-blue); white-space: nowrap; }
      .a-del { background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: .9rem; }
      .a-del:hover { color: var(--danger); }
      .a-empty { text-align: center; padding: 50px; color: var(--text-muted); }
    </style>

    <script is:inline>
      (function () {
        const API = (window.__API_BASE__ || 'https://api.rentease9ja.com');
        const KEY = 're_admin_secret';
        const $ = (id) => document.getElementById(id);
        const fmtDate = (s) => { if (!s) return '—'; const d = new Date(s); return isNaN(d) ? s : d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + ' · ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }); };
        const esc = (v) => (v == null ? '' : String(v)).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

        const TABS = {
          waitlist:  { label: 'Waitlist',  path: '/v1/waitlist',  cols: [
            { h: 'Name',  g: (r) => [r.first_name, r.last_name].filter(Boolean).join(' ') },
            { h: 'Email', g: (r) => r.email }, { h: 'Phone', g: (r) => r.phone },
            { h: 'Role',  g: (r) => r.role, pill: true }, { h: 'State', g: (r) => r.state },
            { h: 'Joined', g: (r) => fmtDate(r.created_at) } ] },
          contact:   { label: 'Contact',   path: '/v1/contact',   cols: [
            { h: 'Name', g: (r) => r.name }, { h: 'Email', g: (r) => r.email },
            { h: 'Subject', g: (r) => r.subject }, { h: 'Message', g: (r) => r.message, msg: true },
            { h: 'Received', g: (r) => fmtDate(r.created_at) } ] },
          partners:  { label: 'Partners',  path: '/v1/partners',  cols: [
            { h: 'Company', g: (r) => r.company }, { h: 'Name', g: (r) => r.name },
            { h: 'Email', g: (r) => r.email }, { h: 'Phone', g: (r) => r.phone },
            { h: 'Type', g: (r) => r.type, pill: true }, { h: 'Details', g: (r) => r.details, msg: true },
            { h: 'Received', g: (r) => fmtDate(r.created_at) } ] },
          investors: { label: 'Investors', path: '/v1/investors', cols: [
            { h: 'Name', g: (r) => r.name }, { h: 'Email', g: (r) => r.email },
            { h: 'Firm', g: (r) => r.firm }, { h: 'Type', g: (r) => r.type, pill: true },
            { h: 'Ticket', g: (r) => r.ticket }, { h: 'Message', g: (r) => r.message, msg: true },
            { h: 'Received', g: (r) => fmtDate(r.created_at) } ] },
        };

        let secret = sessionStorage.getItem(KEY) || '';
        let current = 'waitlist';
        const cache = {}; // tab -> entries[]

        function headers() { return { 'x-admin-secret': secret }; }
        async function api(path, opts) {
          const res = await fetch(API + path, Object.assign({ headers: headers() }, opts || {}));
          if (res.status === 401) { logout('Invalid or expired secret. Please sign in again.'); throw new Error('unauthorized'); }
          return res.json();
        }

        // ---- auth ----
        $('login-form').addEventListener('submit', async (e) => {
          e.preventDefault();
          const val = $('secret').value.trim();
          if (!val) return;
          $('login-error').classList.remove('show');
          $('login-btn').disabled = true; $('login-btn').textContent = 'Checking…';
          secret = val;
          try {
            const data = await api(TABS.waitlist.path + '/admin/list');
            sessionStorage.setItem(KEY, secret);
            cache.waitlist = data.entries || [];
            showDash();
          } catch (err) {
            secret = '';
            $('login-error').textContent = 'Invalid admin secret. Please try again.';
            $('login-error').classList.add('show');
          } finally {
            $('login-btn').disabled = false; $('login-btn').innerHTML = 'Sign in <i class="fas fa-arrow-right"></i>';
          }
        });

        function logout(msg) {
          secret = ''; sessionStorage.removeItem(KEY);
          $('dash').hidden = true; $('login').style.display = 'grid';
          $('secret').value = '';
          if (msg) { $('login-error').textContent = msg; $('login-error').classList.add('show'); }
        }
        $('logout').addEventListener('click', () => logout());

        // ---- dashboard ----
        function showDash() {
          $('login').style.display = 'none'; $('dash').hidden = false;
          renderTabs(); selectTab('waitlist');
        }
        function renderTabs() {
          $('tabs').innerHTML = Object.keys(TABS).map((k) =>
            `<button class="a-tab" data-tab="${k}">${TABS[k].label}<span class="count" id="cnt-${k}">·</span></button>`).join('');
          $('tabs').querySelectorAll('[data-tab]').forEach((b) => b.addEventListener('click', () => selectTab(b.dataset.tab)));
        }
        async function selectTab(tab) {
          current = tab;
          $('tabs').querySelectorAll('.a-tab').forEach((b) => b.classList.toggle('active', b.dataset.tab === tab));
          $('search').value = '';
          await load(tab);
          render();
        }
        async function load(tab, force) {
          if (cache[tab] && !force) return;
          $('state').textContent = 'Loading…'; $('table').innerHTML = '';
          try { const data = await api(TABS[tab].path + '/admin/list'); cache[tab] = data.entries || []; }
          catch (e) { if (e.message !== 'unauthorized') $('state').textContent = 'Could not load. Check your connection.'; }
        }
        function rows() {
          const q = $('search').value.trim().toLowerCase();
          let list = cache[current] || [];
          if (q) list = list.filter((r) => JSON.stringify(r).toLowerCase().includes(q));
          return list;
        }
        function render() {
          const cfg = TABS[current], list = rows();
          $('cnt-' + current) && ($('cnt-' + current).textContent = (cache[current] || []).length);
          $('state').textContent = list.length + ' record' + (list.length === 1 ? '' : 's');
          if (!list.length) { $('table').innerHTML = '<tr><td><div class="a-empty"><i class="fas fa-inbox"></i><br>No records yet.</div></td></tr>'; return; }
          const head = '<tr>' + cfg.cols.map((c) => `<th>${c.h}</th>`).join('') + '<th></th></tr>';
          const body = list.map((r) => '<tr>' + cfg.cols.map((c) => {
            const v = c.g(r);
            if (!v) return '<td>—</td>';
            if (c.pill) return `<td><span class="a-pill">${esc(v)}</span></td>`;
            return `<td class="${c.msg ? 'msg' : ''}">${esc(v)}</td>`;
          }).join('') + `<td><button class="a-del" data-id="${esc(r.id)}" title="Delete"><i class="fas fa-trash"></i></button></td></tr>`).join('');
          $('table').innerHTML = head + body;
          $('table').querySelectorAll('.a-del').forEach((b) => b.addEventListener('click', () => del(b.dataset.id)));
        }
        async function del(id) {
          if (!id || !confirm('Delete this record permanently?')) return;
          try { await api(TABS[current].path + '/admin/' + encodeURIComponent(id), { method: 'DELETE' }); cache[current] = (cache[current] || []).filter((r) => String(r.id) !== String(id)); render(); }
          catch (e) {}
        }
        $('refresh').addEventListener('click', async () => { await load(current, true); render(); });
        $('search').addEventListener('input', render);
        $('export').addEventListener('click', () => {
          const cfg = TABS[current], list = rows();
          const head = cfg.cols.map((c) => c.h);
          const csv = [head.join(',')].concat(list.map((r) => cfg.cols.map((c) => '"' + String(c.g(r) ?? '').replace(/"/g, '""') + '"').join(','))).join('\n');
          const a = document.createElement('a');
          a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
          a.download = 'rentease-' + current + '.csv'; a.click();
        });

        // auto-resume session
        if (secret) {
          api(TABS.waitlist.path + '/admin/list').then((d) => { cache.waitlist = d.entries || []; showDash(); }).catch(() => logout());
        }
      })();
    </script>
  </body>
</html>
