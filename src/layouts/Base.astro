---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';

const {
  title = 'RentEase 9ja: Rent, Buy & Sell Property in Nigeria, Safely',
  description = "Nigeria's safest, most trusted property platform. Verified listings, real agents, secure rent payments, and digital agreements, all in one app.",
  active = '',
  ogImage = '/og-cover.png',
  noFooter = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://rentease9ja.com').href;

// API base is centralized in src/config.ts (set window.__API_BASE__ for client scripts).
import { API_BASE } from '../config';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'RentEase 9ja',
  url: 'https://rentease9ja.com',
  logo: 'https://rentease9ja.com/logo.webp',
  description,
  sameAs: [
    'https://x.com/rentease9ja',
    'https://www.instagram.com/rentease9ja',
    'https://www.tiktok.com/@rentease_9ja',
  ],
  areaServed: 'NG',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline define:vars={{ API_BASE }}>window.__API_BASE__ = API_BASE;</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1E4E8C" />

    <!-- Privacy-friendly analytics (no cookies). Activate by adding the domain in Plausible. -->
    <script defer data-domain="rentease9ja.com" src="https://plausible.io/js/script.js" is:inline></script>

    <!-- Favicons (multi-size .ico is authoritative for the browser tab; ?v bust forces past aggressive favicon caching) -->
    <link rel="icon" href="/favicon.ico?v=5" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=5" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=5" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RentEase 9ja" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://rentease9ja.com').href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rentease9ja" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav active={active} />
    <main id="main">
      <slot />
    </main>
    {!noFooter && <Footer />}
    <ContactModal />

    <script>
      // Scroll reveal
      const els = document.querySelectorAll('.reveal');
      if (els.length) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      }

      // Count-up for stat numbers (parses a leading number, keeps prefix/suffix)
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const counters = document.querySelectorAll('.count-up');
      const runCount = (el) => {
        const raw = (el.textContent || '').trim();
        const m = raw.match(/^(\D*)([\d.,]+)(.*)$/);
        if (!m) { el.classList.add('counted'); return; }
        const prefix = m[1], suffix = m[3];
        const clean = m[2].replace(/,/g, '');
        const target = parseFloat(clean);
        const decimals = clean.includes('.') ? (clean.split('.')[1] || '').length : 0;
        const hasComma = m[2].includes(',');
        const fmt = (n) => {
          let s = decimals ? n.toFixed(decimals) : Math.round(n).toString();
          if (hasComma) s = Number(s).toLocaleString('en-US');
          return prefix + s + suffix;
        };
        el.classList.add('counted');
        if (prefersReduced || !isFinite(target)) { el.textContent = raw; return; }
        const dur = 1200, start = performance.now();
        const tick = (t) => {
          const p = Math.min(1, (t - start) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt(target * eased);
          if (p < 1) requestAnimationFrame(tick); else el.textContent = raw;
        };
        requestAnimationFrame(tick);
      };
      if (counters.length) {
        const cio = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { runCount(e.target); cio.unobserve(e.target); } });
        }, { threshold: 0.5 });
        counters.forEach((el) => cio.observe(el));
      }
    </script>

    <!-- Adigun: RentEase 9ja AI assistant (Tawk.to), available site-wide -->
    <script is:inline>
      var Tawk_API = Tawk_API || {}, Tawk_LoadStart = new Date();
      (function () {
        var s1 = document.createElement('script'), s0 = document.getElementsByTagName('script')[0];
        s1.async = true;
        s1.src = 'https://embed.tawk.to/6a2eb6a6ccc4ac1d4891bba9/1jre12fk6';
        s1.charset = 'UTF-8';
        s1.setAttribute('crossorigin', '*');
        s0.parentNode.insertBefore(s1, s0);
      })();
    </script>
  </body>
</html>
